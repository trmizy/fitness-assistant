+test("[REGRESSION D48] refund: a full APPROVE the ledger could only partly pay is NOT recorded as a full refund - the order carries what was actually paid and says the rest is being reconciled", async () => {
+  const sellerId = `pt-${randomUUID()}`;
+  const { order, buyerId } = await deliverToDraft(sellerId); // DRAFT_DELIVERED, price 100000
+  await personalizedServiceService.requestRefund(order.id, buyerId, "PT unresponsive");
+
+  personalizedServiceDeps.refundOrder = async (params) => ({
+    refund: "40000.00",
+    clawedBack: { pt: "36000.00", platform: "4000.00" },
+    shortfall: "60000.00",
+    owed: params.refundAmount.toFixed(2),
+    paid: "40000.00",
+    unpaid: "60000.00",
+    obligationId: "obl-1",
+  });
+  try {
+    const resolved = await personalizedServiceService.adminResolveRefund(order.id, `admin-${randomUUID()}`, {
+      decision: "APPROVE", refundAmount: 100000, note: "Full refund approved",
+    });
+    assert.equal(resolved.status, "DRAFT_DELIVERED", "not REFUNDED: 60.000 has not been paid");
+    assert.equal(resolved.cumulativeRefundedAmount, 40000, "the amount the ledger actually paid, not the requested 100.000");
+    assert.equal(resolved.refundDecision, "APPROVED_PARTIAL");
+    assert.equal(resolved.refundedAt, null);
+    assert.ok(resolved.refundResolutionNote?.includes("Đã hoàn 40.000đ; 60.000đ còn lại đang được đối soát"), resolved.refundResolutionNote ?? "");
+    assert.ok(resolved.refundResolutionNote?.includes("obl-1"));
+  } finally {
+    stubPaymentSuccess();
+  }
+});
+

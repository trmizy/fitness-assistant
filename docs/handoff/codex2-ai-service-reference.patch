+/**
+ * What a payment-service refund ACTUALLY paid the client, and what is still unpaid (D48/DQ-3).
+ * payment-service refunds an order out of the order's own pending money only; the part it could not fund is an OPEN
+ * obligation it reconciles separately. A result stored before it returned owed/paid/unpaid paid `refund` in full.
+ */
+export function refundOutcome(result: { refund: string; paid?: string; unpaid?: string }) {
+  const paid = Number(result.paid ?? result.refund);
+  const unpaid = Number(result.unpaid ?? 0);
+  return { paid, unpaid };
+}
+
+const vnd = (n: number) => `${Math.round(n).toLocaleString("vi-VN")}đ`;
+
+/** Words for the resolution note: never claims a full refund when part of it is still unpaid. */
+export function refundOutcomeNote(paid: number, unpaid: number): string {
+  return unpaid > 0.005 ? `Đã hoàn ${vnd(paid)}; ${vnd(unpaid)} còn lại đang được đối soát` : `Đã hoàn ${vnd(paid)}`;
+}
+

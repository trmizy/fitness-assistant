w"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="0" pageScale="1" pageWidth="1600" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Thực tế: KHÔNG phải multi-agent kiểu planner↔executor↔critic tự đàm phán. Là 1 &quot;agent&quot; (fitness-agent.service.ts) điều phối nhiều module chuyên trách theo state machine + router luật. LLM chỉ dùng ở vài điểm hẹp (route phụ, diễn giải, sinh nội dung plan)." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="50" as="geometry"/></mxCell><mxCell id="n3" value="Câu hỏi từ&#xa;orchestrator (bước 3)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="150" height="60" as="geometry"/></mxCell><mxCell id="n4" value="tryTurnUnguarded&#xa;• parseFitnessAgentIntent (regex vi)&#xa;• ownSession: userId === session.userId" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="90" width="210" height="80" as="geometry"/></mxCell><mxCell id="n5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n6" value="Confirmation boundary&#xa;&quot;xác nhận / ok lưu&quot; chỉ khớp action PENDING thật (FitnessAgentAction) — LLM không thể bịa &quot;đã lưu&quot;" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="80" width="230" height="100" as="geometry"/></mxCell><mxCell id="n7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="Global turn router (CI-V2 = on)&#xa;classifyGlobal → READ_STATE · RECOMMEND · WRITE_ACTION · START_WORKFLOW · KNOWLEDGE_QA · SLOT_ANSWER · CANCEL · MULTI …" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="80" width="260" height="100" as="geometry"/></mxCell><mxCell id="n9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="LLM route (tùy chọn)&#xa;CI_V2_LLM=on, timeout ngắn; kết quả bị limitLlmRoute / policy kiểm lại" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="80" width="230" height="100" as="geometry"/></mxCell><mxCell id="n11" value="không chắc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;dashed=1;fontSize=11;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="READ_STATE&#xa;readState() → Enterprise Data (service nghiệp vụ) → render tự nhiên" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="240" width="230" height="70" as="geometry"/></mxCell><mxCell id="n13" value="RECOMMEND&#xa;scorePT / scoreTrainingProgramV2 xác định + narrator LLM (có fallback)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="240" width="230" height="70" as="geometry"/></mxCell><mxCell id="n14" value="WRITE_ACTION&#xa;chỉ tạo PROPOSAL → thẻ PROFILE_UPDATE_CONFIRMATION" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="240" width="230" height="70" as="geometry"/></mxCell><mxCell id="n15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n8" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n8" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n8" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="MULTI (câu ghép)?&#xa;planBoundedTurn (thuần, không I/O)" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="350" width="260" height="110" as="geometry"/></mxCell><mxCell id="n19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n8" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="BOUNDED_EXECUTOR&#xa;chỉ READ + RECOMMEND(PT/PROGRAM), có MAX_READS / MAX_RECOMMENDATIONS; cần GYMINI_UNIFIED_AI_COACH=on" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="350" width="260" height="70" as="geometry"/></mxCell><mxCell id="n21" value="EXISTING_MULTI composer (phần còn lại)&#xa;vượt giới hạn → UNSUPPORTED, degrade nhẹ nhàng" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="440" width="260" height="60" as="geometry"/></mxCell><mxCell id="n22" value="READ+RECOMMEND" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" paren
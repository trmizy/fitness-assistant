"1" pageWidth="1600" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Harness = lớp &quot;dây cương&quot; quanh LLM. (A) Runtime harness: chặn / kiểm / fallback mỗi lượt. (B) Evaluation harness: đo chất lượng offline trước khi bật tính năng (feature flag)." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="n3" value="A. RUNTIME HARNESS — mọi output của LLM đều đi qua các lớp này" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;dashed=1;fontSize=13;opacity=60;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1560" height="340" as="geometry"/></mxCell><mxCell id="n4" value="INPUT&#xa;languageGuard&#xa;(vi/en, không dấu)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="175" height="170" as="geometry"/></mxCell><mxCell id="n5" value="safetyGuard (regex)&#xa;11 loại: giảm cân cực đoan, &lt;800 kcal, thai kỳ, vị thành niên, ED, PED, injection, off-topic → template tĩnh" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="255" y="120" width="175" height="170" as="geometry"/></mxCell><mxCell id="n6" value="Routing xác định&#xa;intent_router, parseFitnessAgentIntent, classifyGlobal (model không chọn action)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="120" width="175" height="170" as="geometry"/></mxCell><mxCell id="n7" value="Grounding&#xa;RAG gates (topic-guard, floor) · Exercise.id catalog · NutritionGoal / Profile là nguồn thật" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1
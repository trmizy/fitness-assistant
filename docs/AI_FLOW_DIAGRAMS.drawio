<mxfile host="app.diagrams.net"><diagram id="p0" name="1. Tong quan AI-service"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="0" pageScale="1" pageWidth="1600" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Gymini AI — kiến trúc tổng quan (ai-service không sở hữu dữ liệu nghiệp vụ; chỉ là lớp AI gọi HTTP/Lambda sang các service nghiệp vụ)" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="n3" value="User&#xa;(Web / Mobile)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="140" height="60" as="geometry"/></mxCell><mxCell id="n4" value="Gateway&#xa;(auth, rate-limit)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="80" width="150" height="60" as="geometry"/></mxCell><mxCell id="n5" value="ai-service&#xa;/ai/chat · /ai/fitness-agent&#xa;/ai/plan · /ai/memories" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="70" width="200" height="80" as="geometry"/></mxCell><mxCell id="n6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="ĐƯỜNG 1: Chat turn (đồng bộ)&#xa;llm/orchestrator.service.ts" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="200" width="190" height="70" as="geometry"/></mxCell><mxCell id="n9" value="ĐƯỜNG 2: Sinh plan (bất đồng bộ)&#xa;workout / nutrition qua queue" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="200" width="190" height="70" as="geometry"/></mxCell><mxCell id="n10" value="ĐƯỜNG 3: Ingest tri thức&#xa;knowledge-pipeline/" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="200" width="190" height="70" as="geometry"/></mxCell><mxCell id="n11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n5" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n5" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n5" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="LLM provider (llm.service.ts)&#xa;ollama | anthropic | bedrock | mock" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="340" width="200" height="80" as="geometry"/></mxCell><mxCell id="n15" value="Embedding&#xa;nomic-embed-text (Ollama)&#xa;hoặc Bedrock" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="340" width="190" height="80" as="geometry"/></mxCell><mxCell id="n16" value="Vector store&#xa;Qdrant | OpenSearch&#xa;fitness_evidence, exercises, faq, knowledge" style="shape=cylinder3;boundedLbl=1;size=10;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="330" width="150" height="100" as="geometry"/></mxCell><mxCell id="n17" value="Queue&#xa;BullMQ/Redis hoặc SQS (AWS)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="480" width="190" height="60" as="geometry"/></mxCell><mxCell id="n18" value="Postgres&#xa;Conversation · ChatSession · UserMemory · FitnessAgentAction · WorkflowState" style="shape=cylinder3;boundedLbl=1;size=10;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="470" width="150" height="100" as="geometry"/></mxCell><mxCell id="n19" value="Service nghiệp vụ (nguồn sự thật)&#xa;fitness / user / gym / payment / auth&#xa;Exercise.id, Roadmap, Cycle, NutritionGoal…" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="480" width="260" height="110" as="geometry"/></mxCell><mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n8" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n8" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n8" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="tools HTTP/Lambda" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n8" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n9" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="worker gọi LLM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n17" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="catalog bài tập thật" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n9" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n10" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="upsert chunk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n10" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n30" value="Nguyên tắc cốt lõi: &quot;deterministic-first, LLM-as-narrator&quot;&#xa;• Quyết định nghiệp vụ (calo, macro, roadmap, chọn PT, ghi dữ liệu) đi qua router luật + engine xác định; LLM chủ yếu diễn giải ngôn ngữ tự nhiên.&#xa;• Mọi thao tác ghi dữ liệu phải qua thẻ xác nhận — LLM không tự thực thi.&#xa;• Output LLM luôn bị validate; sai lệch → thay bằng câu trả lời xác định (fallback).&#xa;• Exercise trong plan chỉ lấy từ catalog thật (Exercise.id), không lấy từ vector DB." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1120" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2. Chat turn - RAG + LLM"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="0" pageScale="1" pageWidth="1600" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Một lượt chat đi qua llm/orchestrator.service.ts → run() (thứ tự theo code hiện tại)" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="n3" value="Câu hỏi user&#xa;(+ sessionId, token)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="150" height="50" as="geometry"/></mxCell><mxCell id="n4" value="1. languageGuard.resolve&#xa;phát hiện vi/en" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="60" width="170" height="50" as="geometry"/></mxCell><mxCell id="n5" value="2. safetyGuard.check&#xa;(regex, trước mọi I/O)" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="40" width="170" height="90" as="geometry"/></mxCell><mxCell id="n6" value="Template an toàn tĩnh&#xa;(vi/en) → kết thúc" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="60" width="170" height="50" as="geometry"/></mxCell><mxCell id="n7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="nguy hiểm / off-topic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="3. fitnessAgent.tryTurn&#xa;khớp action / workflow / CI?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="170" width="190" height="100" as="geometry"/></mxCell><mxCell id="n11" value="an toàn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n5" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="Trả lời ngay (responseSource = fitness_agent)&#xa;KHÔNG chạm RAG / LLM-chat&#xa;→ xem trang 3" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="185" width="220" height="70" as="geometry"/></mxCell><mxCell id="n13" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n10" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="4. Lấy ngữ cảnh SONG SONG (timeout: context 5s, RAG 8s)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;dashed=1;fontSize=13;opacity=60;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="820" height="150" as="geometry"/></mxCell><mxCell id="n15" value="profileExtractor&#xa;profile + personalization" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="180" height="70" as="geometry"/></mxCell><mxCell id="n16" value="retriever.retrieveForChat&#xa;(RAG; bỏ qua nếu là lookup nutrition/schedule)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="350" width="190" height="70" as="geometry"/></mxCell><mxCell id="n17" value="5 lượt chat gần nhất&#xa;(lọc fallback / thumbs-down)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="350" width="170" height="70" as="geometry"/></mxCell><mxCell id="n18" value="UserMemory&#xa;tối đa 20 fact (FIFO)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="350" width="180" height="70" as="geometry"/></mxCell><mxCell id="n19" value="không khớp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n10" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="5. Engine xác định (TypeScript thuần, KHÔNG LLM): inputParser · intentRouter (regex) · nutrition_engine (TDEE/macro) · workout_schedule_context · body_composition_rules · recommendationEngine · coach_context_builder" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="820" height="90" as="geometry"/></mxCell><mxCell id="n21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n14" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="6. promptBuilder.build&#xa;gộp: câu hỏi + input + profile + RAG docs + khuyến nghị + history" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="210" height="80" as="geometry"/></mxCell><mxCell id="n23" value="Intent cần văn bản sinh động?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="615" width="170" height="110" as="geometry"/></mxCell><mxCell id="n24" value="ENABLE_TOOL_CALLING?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="615" width="160" height="110" as="geometry"/></mxCell><mxCell id="n25" value="runToolCallingTurn (≤2 tool, 1 vòng)&#xa;search_exercise_library · get_user_fitness_data · remember_user_fact" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="560" width="230" height="80" as="geometry"/></mxCell><mxCell id="n26" value="llmService.callLLM&#xa;(1 lần gọi / turn)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="670" width="230" height="60" as="geometry"/></mxCell><mxCell id="n27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n20" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n22" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n23" target="n24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n30" value="bật" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n24" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n31" value="tắt (mặc định)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n24" target="n26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n32" value="Dùng câu trả lời xác định&#xa;(không gọi LLM)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="780" width="170" height="50" as="geometry"/></mxCell><mxCell id="n33" value="không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n23" target="n32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="7. answerValidator.validate&#xa;lệch số liệu / rỗng / từ chối ngoài phạm vi?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="590" width="220" height="130" as="geometry"/></mxCell><mxCell id="n35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n25" target="n34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n26" target="n34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n37" value="BỎ câu LLM → thay bằng&#xa;câu trả lời xác định (fallback)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="780" width="220" height="60" as="geometry"/></mxCell><mxCell id="n38" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n34" target="n37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n39" value="8. responseFormatter + labelLocalizer + traceLogger&#xa;+ lưu Conversation + persistDeterministicMemoryCandidates" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="880" width="330" height="70" as="geometry"/></mxCell><mxCell id="n40" value="không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n34" target="n39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n37" target="n39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n32" target="n39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n43" value="RAG chi tiết (retriever.ts + retrieval-v2.ts; V2 bật bằng RAG_RETRIEVAL_V2=on, mặc định OFF)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;dashed=1;fontSize=13;opacity=60;" vertex="1" parent="1"><mxGeometry x="900" y="60" width="640" height="470" as="geometry"/></mxCell><mxCell id="n44" value="Query → expandQueries() (rule-based)&#xa;/ detect concept (V2)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="110" width="170" height="60" as="geometry"/></mxCell><mxCell id="n45" value="Embed query&#xa;(nomic-embed-text 768d)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="110" width="170" height="60" as="geometry"/></mxCell><mxCell id="n46" value="4 collection&#xa;exercises · knowledge&#xa;faq · fitness_evidence" style="shape=cylinder3;boundedLbl=1;size=10;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="100" width="140" height="90" as="geometry"/></mxCell><mxCell id="n47" value="Lọc: MIN_SCORE 0.35 · filter thiết bị tại nhà (must_not typeOfEquipment)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="210" width="170" height="70" as="geometry"/></mxCell><mxCell id="n48" value="V2: topic-guard + per-class cosine floor; safety chỉ nhận curated evidence" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="210" width="200" height="70" as="geometry"/></mxCell><mxCell id="n49" value="Rank TRONG từng source-class (không so điểm chéo class)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="310" width="170" height="70" as="geometry"/></mxCell><mxCell id="n50" value="Dedupe (exact + token-Jaccard) → giữ class uy tín hơn" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="310" width="200" height="70" as="geometry"/></mxCell><mxCell id="n51" value="Pack top-K (RAG_TOP_K=5) kèm provenance + cờ conflict (2 nguồn curated lệch khoảng cho cùng scope)&#xa;→ RetrievalResult đưa vào promptBuilder (bước 6)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="410" width="390" height="80" as="geometry"/></mxCell><mxCell id="n52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n44" target="n45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n53" value="" style="edgeStyle=orthogonalEdgeStyle;round
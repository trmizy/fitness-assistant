{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "aws-dev": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.gymini.vn",
        "EXPO_PUBLIC_AI_STREAM_URL": "https://gymini.vn/ai/ask/stream",
        "EXPO_PUBLIC_CHAT_WS_URL": "https://gymini.vn",
        "EXPO_PUBLIC_ENABLE_REALTIME": "false",
        "EXPO_PUBLIC_ENABLE_CHAT": "true",
        "EXPO_PUBLIC_ENABLE_CHAT_WS": "true"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}

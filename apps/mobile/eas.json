{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000",
        "EXPO_PUBLIC_MOCK": "0"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging-api.YOUR_DOMAIN.example",
        "EXPO_PUBLIC_MOCK": "0"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.YOUR_DOMAIN.example",
        "EXPO_PUBLIC_MOCK": "0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

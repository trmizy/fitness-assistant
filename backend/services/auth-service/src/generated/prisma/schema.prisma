generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Money-flow redesign plan 5.1: GYM_STAFF removed. It only ever existed as an enum value and
// a frontend route — no model, no business logic, no screen ever built for it — while the
// frontend still routed a user with this role into a workspace where the backend rejected
// every action with 403. Verified zero accounts held this role before removing it (see the
// project's "Quyết định phát sinh" doc for the exact query). Gym owners operate everything
// themselves now; a staff role is explicitly out of scope (see docs/money-flow.md's scope
// section).
enum Role {
  CUSTOMER
  PT
  ADMIN
  GYM_OWNER
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  password           String
  firstName          String?
  lastName           String?
  role               Role     @default(CUSTOMER)
  isActive           Boolean  @default(true)
  /// Set true only when an admin creates the account directly (currently just gym owners —
  /// see authService.createGymOwnerAccount) with a random temporary password the admin relays
  /// out of band. Cleared the moment ANY password change succeeds (self-service or this
  /// forced one go through the same changePassword path) — never touched anywhere else, so a
  /// normal self-registered user is never affected by this flag at all.
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  passwordResets PasswordResetToken[]

  @@map("users")
}

/// Đặt lại mật khẩu bằng LINK, không bao giờ bằng mật khẩu gửi qua email — cùng nguyên
/// tắc với thư mời đối tác (xem gym-service/PartnerInvitation): một mật khẩu gửi đi là
/// credential sống trôi nổi vô thời hạn, và nếu người nhận không bao giờ dùng thì không
/// ai biết.
///
/// ⚠️ LƯU BĂM (sha256), KHÔNG LƯU TOKEN GỐC. Token gốc chỉ tồn tại một lần trong phản hồi
/// lúc tạo, để nhét vào link gửi đi.
model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  /// Quản trị viên đã bấm "Đặt lại mật khẩu"; null nếu người dùng tự yêu cầu.
  requestedBy String?   @map("requested_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model EmailVerification {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  otpHash      String
  attempts     Int      @default(0)
  expiresAt    DateTime
  sentAt       DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
  @@map("email_verifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // "LOGIN", "LOGOUT", "REGISTER", "REFRESH_TOKEN", "PASSWORD_CHANGE"
  ipAddress String?
  userAgent String?
  metadata  Json? // Additional context
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── PT deactivation relay (money-flow redesign plan 2.6) ──────────────────────────────────
//
// Locking a PT's account here only ever flipped `isActive` — user-service's
// ptDeactivationService.deactivatePT (which unwinds live contracts with prorated refunds and
// hides the PT from discovery) already existed with a ready internal endpoint, but nothing in
// auth-service ever called it. This table is the retry record for that cross-service call: if
// it fails, the account lock itself still succeeds (the primary action must not be blocked by
// a secondary one), but the failure is recorded here instead of silently swallowed, and
// pt-deactivation-relay-sweep.service.ts retries it.
enum PtDeactivationAction {
  DEACTIVATE
  REACTIVATE
}

enum PtDeactivationCallStatus {
  PENDING
  SETTLED
  FAILED
}

model PtDeactivationCall {
  id        String                   @id @default(uuid())
  ptUserId  String                   @map("pt_user_id")
  action    PtDeactivationAction
  adminId   String                   @map("admin_id")
  reason    String?
  status    PtDeactivationCallStatus @default(PENDING)
  attempts  Int                      @default(0)
  lastError String?                  @map("last_error")
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")

  @@index([status])
  @@map("pt_deactivation_calls")
}

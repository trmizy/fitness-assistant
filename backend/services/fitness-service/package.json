{
  "name": "@gym-coach/fitness-service",
  "version": "1.0.0",
  "private": true,
  "prisma": {
    "seed": "./node_modules/.bin/tsx prisma/seed_exercises_json.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "./node_modules/.bin/tsx prisma/seed_exercises_json.ts",
    "db:seed:legacy": "tsx prisma/seed.ts",
    "db:process-usda": "tsx prisma/process-usda.ts",
    "test": "tsx --test src/__tests__/*.test.ts",
    "workout:test:completion": "tsx src/scripts/testWorkoutCompletion.ts",
    "workout:check-consistency": "tsx src/scripts/checkWorkoutConsistency.ts",
    "build:lambda-zip": "node scripts/build-lambda-artifact.js",
    "build:migrate-lambda-zip": "node scripts/build-migrate-lambda-artifact.js"
  },
  "dependencies": {
    "@gym-coach/shared": "workspace:*",
    "@prisma/client": "^5.22.0",
    "@aws-sdk/client-lambda": "^3.1118.0",
    "@aws-sdk/client-secrets-manager": "^3.1118.0",
    "axios": "^1.6.5",
    "bullmq": "^5.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.1",
    "redis": "^4.6.12",
    "serverless-http": "^4.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.23.1",
    "prisma": "^5.22.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GymStatus {
  // GYM_BRANCH_FORM_SPEC.md — the "Add Branch" wizard's shell (Phase 1) needs a state before
  // PENDING_REVIEW: the owner can leave the 7-step wizard at any point and come back later
  // without having triggered full validation yet. A DRAFT is never visible to admin, never
  // counted in any admin queue, and never reachable by a client — every existing query that
  // filters by status (public listing, admin moderation queue, `partnerDiligenceService`'s
  // counts) already filters to a specific status or an explicit allow-list, so this new value
  // is inert everywhere until the owner explicitly submits (DRAFT -> PENDING_REVIEW).
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

/// Vòng 4 / Phase C3 — the owner's own "are we physically open" switch, orthogonal to
/// GymStatus above (the admin's "is this gym allowed on the platform" moderation gate). Every
/// checkpoint that requires APPROVED also requires OPEN — see membership.service.ts,
/// checkin.service.ts, gym.repository.ts's public-listing queries.
enum GymOperationalStatus {
  OPEN
  TEMPORARILY_CLOSED
  /// One-way — nothing in this codebase transitions a gym back out of PERMANENTLY_CLOSED.
  /// Creates an admin actionable item (gymService.listPermanentlyClosedNeedingReview) rather
  /// than auto-refunding active memberships — see docs/vong-4.md's closure compensation table
  /// (policy only, not code).
  PERMANENTLY_CLOSED
}

enum GymMembershipPlanStatus {
  ACTIVE
  INACTIVE
}

enum GymMembershipContractStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
  /// P0 cluster E2 — the gym was suspended/closed/removed between checkout and the payment
  /// webhook: money already settled into escrow + gym/platform pending, but activating a
  /// membership at a gym no longer allowed to operate would be wrong. An auto-refund is
  /// attempted immediately (see membershipService.resolvePendingIssue); if that itself fails
  /// (payment-service unreachable), the row stays here as an admin queue until manually
  /// resolved — never silently dropped.
  PENDING_ISSUE
}

enum AffiliationStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum AffiliationEmployment {
  IN_HOUSE
  FREELANCE
  PARTNER
}

enum GymTrainerVisibility {
  PUBLIC
  INTERNAL_ONLY
}

// ── Giờ hoạt động (GYM_BRANCH_FORM_SPEC.md, Phase 2) ─────────────────────────────────────

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// §18/§20 — chỉ 3 trạng thái, không có "khoảng giờ tách đôi" (06:00-12:00, 14:00-22:00) vì
/// backend không hỗ trợ điều đó — cố ý không giả vờ có (§20: "If backend does not support
/// it, do NOT fake it").
enum DayScheduleType {
  OPEN
  CLOSED
  ALL_DAY
}

// ── Tiện ích & dịch vụ (GYM_BRANCH_FORM_SPEC.md, Phase 3 — Bước 4) ───────────────────────
//
// Một danh mục cố định, chủ gym chọn nhiều — mảng Postgres ngay trên Gym, cùng khuôn mẫu với
// GymPartnerAccount.scopedGymIds, không cần bảng nối riêng ở quy mô này (mỗi gym nhiều nhất
// vài chục mục, không phải hàng nghìn).
enum GymFacility {
  FREE_WEIGHTS
  CARDIO_MACHINES
  FUNCTIONAL_TRAINING_AREA
  GROUP_CLASSES
  YOGA_STUDIO
  SWIMMING_POOL
  PERSONAL_TRAINER
  INBODY_SCAN
  LOCKER_ROOM
  SHOWER
  SAUNA
  TOWEL_SERVICE
  PARKING
  WIFI
  AIR_CONDITIONING
  DRINKING_WATER
  KIDS_AREA
  VENDING_MACHINE
}

// ── Hình ảnh chi nhánh (GYM_BRANCH_FORM_SPEC.md, Phase 3 — Bước 5) ───────────────────────
//
// CÔNG KHAI — khác hẳn ảnh minh chứng khiếu nại (GymComplaint.photoTokens, riêng tư) và
// giấy tờ xác minh chi nhánh (GymBranchDocument bên dưới, riêng tư): đây là thư viện ảnh
// marketing, khách xem được khi tìm phòng gym, cùng mức công khai với ảnh đại diện hồ sơ
// (user-service's profile-photos) — phục vụ bằng express.static, không qua route xác thực.
model GymPhoto {
  id         String             @id @default(uuid())
  gymId      String             @map("gym_id")
  /// Tên tệp trên đĩa (không phải URL đầy đủ) — ghép với `/uploads/gym-photos/` ở phía
  /// client, cùng quy ước tối giản với GymComplaint.photoTokens (lưu token, không lưu URL).
  fileName   String             @map("file_name")
  sortOrder  Int                @default(0) @map("sort_order")
  /// Đúng một ảnh có isCover=true tại một thời điểm cho mỗi gym — ràng buộc này do
  /// gymPhotoService tự đảm bảo (bỏ cờ ảnh cũ trước khi đặt cờ ảnh mới), không phải ở CSDL.
  isCover    Boolean            @default(false) @map("is_cover")
  /// Ảnh lưu ở S3 (hồ sơ tự đăng ký): khoá đối tượng do SERVER sinh. Null = ảnh đĩa cũ.
  s3Key      String?            @map("s3_key")
  category   GymPhotoCategory?
  /// PRIVATE cho tới khi hồ sơ được duyệt; sau đó ảnh được sao chép sang vùng công khai.
  visibility GymPhotoVisibility @default(PUBLIC)
  createdAt  DateTime           @default(now()) @map("created_at")

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, sortOrder])
  @@map("gym_photos")
}

// ── Giấy tờ xác minh CHI NHÁNH (GYM_BRANCH_FORM_SPEC.md, Phase 3 — Bước 6) ────────────────
//
// §95.4 — KHÔNG phải giấy tờ xác minh ĐỐI TÁC (GymPartnerDocument: giấy phép kinh doanh, mã
// số thuế, CCCD người đại diện — đã thu thập đúng MỘT LẦN lúc thẩm định đối tác). Bảng này
// chỉ chứa giấy tờ gắn với ĐỊA ĐIỂM cụ thể của chi nhánh đang tạo. Cùng khuôn mẫu một-dòng-
// một-loại-giấy-tờ với GymPartnerDocument (@@unique trên [gymId, docType]), tái dùng luôn
// PartnerDocumentStatus thay vì định nghĩa một enum trạng thái trùng lặp. Khác
// GymPartnerDocument ở chỗ CHỦ GYM tự tải lên qua wizard (không phải admin nhập tay fileUrl)
// — nên cần một token riêng tư + route phục vụ có xác thực, cùng khuôn mẫu với
// complaint-photo.controller.ts (KHÔNG mount express.static công khai).
enum BranchDocumentType {
  LEASE_OR_PROPERTY_DOC
  FIRE_SAFETY_CERTIFICATE
  FACILITY_PHOTOS
}

model GymBranchDocument {
  id         String                @id @default(uuid())
  gymId      String                @map("gym_id")
  docType    BranchDocumentType    @map("doc_type")
  /// Fire safety certificate không bắt buộc ở mọi địa phương — giống required=false của
  /// GymPartnerDocument cho các mục 🟡. Hai mục còn lại luôn bắt buộc.
  required   Boolean               @default(true)
  /// Token do branchDocumentPhotoController cấp lúc tải lên (KHÔNG phải URL công khai) —
  /// cùng quy ước với GymComplaint.photoTokens.
  fileToken  String?               @map("file_token")
  status     PartnerDocumentStatus @default(PENDING)
  verifiedBy String?               @map("verified_by")
  verifiedAt DateTime?             @map("verified_at")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, docType])
  @@index([gymId])
  @@map("gym_branch_documents")
}

// ── "Yêu cầu chỉnh sửa" theo hạng mục (GYM_BRANCH_FORM_SPEC.md, Phase 4) ─────────────────
//
// KHÁC hẳn Gym.pendingNameNote/pendingAddressNote (Vòng 4 / Phase C2 — 2 trường, dành riêng
// cho một chi nhánh ĐÃ ĐƯỢC DUYỆT xin đổi tên/địa chỉ sau này). Cơ chế này dành cho lần
// DUYỆT ĐẦU TIÊN qua wizard 7 bước: admin gắn N vấn đề theo đúng 7 hạng mục tương ứng 7 bước,
// mỗi vấn đề có nội dung riêng — chủ gym thấy đúng danh sách này, link tới đúng bước cần sửa.
enum BranchReviewCategory {
  BASIC_INFO
  LOCATION
  OPENING_HOURS
  FACILITIES
  PHOTOS
  VERIFICATION
  OTHER
}

/// Không có "hội thoại qua lại" — cùng kỷ luật đã chốt cho GymComplaint: một `message` mỗi
/// vấn đề, không phải luồng chat. Đóng (resolvedAt) khi chủ gym gửi lại hồ sơ thành công
/// (gymDraftService.submitForReview tự đóng TẤT CẢ vấn đề còn mở của gym đó) — đơn giản hơn
/// dò từng trường xem "đã sửa đúng ý chưa", và khớp đúng luồng thao tác: sửa xong 1 lượt qua
/// wizard rồi gửi lại 1 lần, không phải đóng từng mục một dọc đường.
model GymBranchReviewIssue {
  id         String               @id @default(uuid())
  gymId      String               @map("gym_id")
  category   BranchReviewCategory
  message    String
  createdBy  String               @map("created_by")
  resolvedAt DateTime?            @map("resolved_at")
  createdAt  DateTime             @default(now()) @map("created_at")

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, resolvedAt])
  @@map("gym_branch_review_issues")
}

/// Đúng 7 dòng cho mỗi gym (một dòng mỗi ngày trong tuần) — @@unique([gymId, day]) đảm bảo
/// không trùng, không thiếu khi đọc. openMinute/closeMinute lưu dạng "số phút từ nửa đêm"
/// (0-1439) thay vì DateTime — giờ mở cửa không gắn với một ngày cụ thể nào, so sánh
/// open < close chỉ là phép so sánh số nguyên, không cần xử lý múi giờ.
model GymOperatingHours {
  id          String          @id @default(uuid())
  gymId       String          @map("gym_id")
  day         WeekDay
  type        DayScheduleType @default(CLOSED)
  /// Chỉ có ý nghĩa khi type = OPEN.
  openMinute  Int?            @map("open_minute")
  closeMinute Int?            @map("close_minute")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, day])
  @@map("gym_operating_hours")
}

// ── Khiếu nại / vi phạm (GYM_MANAGEMENT master spec, Phase 5) ────────────────────────────
//
// Một bảng DUY NHẤT cho mọi nguồn — quyết định đã chốt với người dùng: không tách bảng
// theo nguồn gốc, chỉ phân biệt bằng cột `source`, để admin có đúng MỘT hàng đợi và MỘT
// dòng lịch sử trên hồ sơ đối tác, bất kể khiếu nại tới từ đâu.

/// Nguồn phát sinh — không phải lựa chọn của người báo cáo, mà do ĐIỂM VÀO xác định:
/// MEMBER_REPORT/PT_REPORT chỉ được set bởi chính endpoint tương ứng (client tự gửi thì
/// chắc chắn là MEMBER_REPORT); SELF_DETECTED/PARTNER_DISCLOSED là hai lựa chọn admin tự
/// chọn khi họ là người nhập tay (biết được qua kênh khác — điện thoại, email, chính đối
/// tác chủ động báo).
enum ComplaintSource {
  SELF_DETECTED
  MEMBER_REPORT
  PT_REPORT
  PARTNER_DISCLOSED
}

enum ComplaintIssueType {
  CLEANLINESS
  STAFF_BEHAVIOR
  EQUIPMENT_CONDITION
  FALSE_ADVERTISING
  BILLING
  SAFETY
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

/// Cố ý KHÔNG làm: hội thoại qua lại (chỉ một `adminResponse` cuối cùng khi RESOLVED,
/// không phải một luồng tin nhắn), liên kết tự động sang hoàn tiền (admin muốn hoàn tiền
/// thì vẫn dùng đúng hành động hoàn tiền hiện có, tự tay, sau khi đọc khiếu nại này),
/// khiếu nại ẩn danh (reporterUserId luôn được ghi nhận cho MEMBER_REPORT/PT_REPORT — badge
/// "ẩn danh" phía UI nếu cần chỉ là hiển thị, dữ liệu vẫn có), phúc thẩm (không có trạng
/// thái nào sau RESOLVED).
model GymComplaint {
  id              String             @id @default(uuid())
  gymId           String             @map("gym_id")
  /// Denormalized từ Gym.ownerId lúc tạo — cho phép tab "Khiếu nại" trên hồ sơ đối tác lọc
  /// thẳng theo partnerId mà không phải join qua Gym mỗi lần đọc. Null cho các gym của chủ
  /// sở hữu có từ trước Phase 1 (không có hồ sơ đối tác).
  partnerId       String?            @map("partner_id")
  source          ComplaintSource
  issueType       ComplaintIssueType @map("issue_type")
  /// Null hợp lệ CHỈ cho SELF_DETECTED/PARTNER_DISCLOSED khi admin không (hoặc chưa) xác
  /// định được chính xác ai là người phản ánh. MEMBER_REPORT/PT_REPORT luôn có giá trị —
  /// xem doc comment ComplaintSource.
  reporterUserId  String?            @map("reporter_user_id")
  description     String
  /// Token do complaintPhotoService cấp lúc tải lên (KHÔNG phải URL công khai — ảnh minh
  /// chứng riêng tư, chỉ admin và chính người báo cáo xem được qua route có xác thực).
  /// Giới hạn 5 ảnh được kiểm ở tầng service, không phải ở đây.
  photoTokens     String[]           @map("photo_tokens")
  status          ComplaintStatus    @default(OPEN)
  /// Thuần hiển thị/lọc "việc của admin nào", cùng quy ước với GymPartner.assignedAdminId.
  assignedAdminId String?            @map("assigned_admin_id")
  adminResponse   String?            @map("admin_response")
  resolvedAt      DateTime?          @map("resolved_at")
  resolvedBy      String?            @map("resolved_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  gym Gym @relation(fields: [gymId], references: [id])

  @@index([gymId, status])
  @@index([partnerId, createdAt])
  @@index([reporterUserId])
  @@index([status])
  @@map("gym_complaints")
}

// ── Đối tác phòng tập (Phase 1 — nền tảng danh tính) ─────────────────────────
//
// Tách "pháp nhân đối tác" khỏi "tài khoản đăng nhập". Trước đây một chủ gym LÀ một
// userId: mật khẩu trở thành thứ bàn giao tay này sang tay khác, quản lý nghỉ việc là
// phải đổi mật khẩu cả nhà, và nhật ký chỉ ghi được một danh tính duy nhất chứ không
// biết ai thao tác.
//
// ⚠️ ĐÂY KHÔNG PHẢI GYM_STAFF QUAY LẠI. Vai trò xác thực vẫn đúng một giá trị
// GYM_OWNER cho mọi tài khoản đối tác — không thêm enum vai trò nào ở auth-service,
// không bộ định tuyến riêng, không màn hình riêng. `PartnerAccountRole` dưới đây là
// quyền BÊN TRONG một đối tác (do gym-service tự phân giải), không phải vai trò hệ thống.

enum GymPartnerStatus {
  /// Hồ sơ admin mở khi nhận email đầu tiên — chưa có tài khoản đăng nhập nào.
  PROSPECT
  /// Đã cấp tài khoản, thư mời đã gửi, chủ sở hữu chưa hoàn tất thiết lập lần đầu.
  INVITED
  ACTIVE
  /// Ngừng bán gói mới + đóng băng rút tiền; hội viên cũ dùng hết hạn (Phase 5).
  SUSPENDED
  TERMINATED
}

/// GYM_MANAGEMENT master spec §60 — trục "đã thẩm định giấy tờ tới đâu", TÁCH RIÊNG khỏi
/// GymPartnerStatus ở trên (đó là "đang ở giai đoạn vòng đời nào"). Một hồ sơ PROSPECT có thể
/// đứng ở bất kỳ giá trị nào dưới đây trong lúc admin còn đang thu thập/xác minh giấy tờ, TRƯỚC
/// khi tài khoản OWNER được cấp — cấp tài khoản chỉ nên xảy ra sau khi đạt VERIFIED. Trước phase
/// này, "từ chối" chỉ được đánh dấu bằng rejectedAt/rejectionReason ngay trên PROSPECT, không
/// phân biệt được "chưa xem" với "đã xem và từ chối" — cột này khắc phục đúng chỗ đó.
enum PartnerVerificationStatus {
  NOT_VERIFIED
  IN_REVIEW
  /// Admin đã yêu cầu bổ sung — verificationNotes chứa nội dung cần bổ sung.
  NEEDS_INFO
  VERIFIED
  REJECTED
}

enum GymPartnerKind {
  BUSINESS
  INDIVIDUAL
}

/// Hai cấp, không hơn. Ranh giới một câu: **tiền và người thì chỉ chủ sở hữu**.
enum PartnerAccountRole {
  OWNER
  MANAGER
}

enum PartnerAccountStatus {
  INVITED
  ACTIVE
  REVOKED
}

enum PartnerInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}


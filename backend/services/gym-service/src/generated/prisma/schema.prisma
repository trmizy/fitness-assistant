// ── Phase 5 ───────────────────────────────────────────────────────────────────

enum TerminationMemberPolicy {
  /// Phục vụ hội viên còn hạn tới hết hạn, ngừng bán gói mới ngay.
  SERVE_UNTIL_EXPIRY
  /// Hoàn tiền theo tỷ lệ phần chưa dùng cho từng hội viên.
  PRORATED_REFUND
}

/// Phase 2 mục 2.4 — nhật ký kiểm toán cho mọi hành động quản trị tác động lên tài khoản
/// người khác: ai · làm gì · lên đối tác/tài khoản nào · lúc nào · lý do · IP.
///
/// Tách khỏi AuditLog của auth-service (bảng đó khoá theo chính người dùng gây ra sự kiện
/// — LOGIN/LOGOUT của bản thân họ). Ở đây chủ thể và đối tượng là hai người khác nhau:
/// một quản trị viên tác động lên hồ sơ của một đối tác. Nhét vào bảng cũ thì cột userId
/// mang hai nghĩa tuỳ dòng — đúng kiểu mập mờ khiến nhật ký kiểm toán mất giá trị.
enum PartnerAuditAction {
  PARTNER_CREATED
  PARTNER_UPDATED
  ACCOUNT_PROVISIONED
  INVITATION_RESENT
  INVITATION_REVOKED
  PASSWORD_RESET_SENT
  SESSIONS_REVOKED
  ACCOUNT_REVOKED
  OWNERSHIP_TRANSFERRED
  PARTNER_SUSPENDED
  PARTNER_UNSUSPENDED
  PARTNER_TERMINATED
  /// Bắt buộc ghi. Không ghi nhật ký thì đây là một cửa hậu.
  VIEWED_AS_PARTNER
  // ── Hồ sơ đối tác tự đăng ký — người thực hiện có thể là admin HOẶC chính ứng viên ──
  APPLICATION_SUBMITTED
  CHANGES_REQUESTED
  ISSUE_MARKED_UPDATED
  APPLICATION_RESUBMITTED
  ISSUE_RESOLVED
  DOCUMENT_UPLOADED
  DOCUMENT_REPLACED
  DOCUMENT_ACCEPTED
  DOCUMENT_UPDATE_REQUESTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  APPLICATION_REOPENED
  DOCUMENT_VIEWED
}

model PartnerAuditLog {
  id              String             @id @default(uuid())
  partnerId       String             @map("partner_id")
  /// Người thực hiện — quản trị viên, hoặc (với các sự kiện hồ sơ tự đăng ký như nộp/nộp lại/
  /// thay tệp) chính ứng viên. KHÔNG phải đối tượng bị tác động.
  actorUserId     String             @map("actor_user_id")
  action          PartnerAuditAction
  /// Tài khoản cụ thể bị tác động, nếu hành động nhắm vào một tài khoản.
  targetAccountId String?            @map("target_account_id")
  reason          String?
  ipAddress       String?            @map("ip_address")
  userAgent       String?            @map("user_agent")
  metadata        Json?
  createdAt       DateTime           @default(now()) @map("created_at")

  partner GymPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@index([actorUserId])
  @@map("partner_audit_logs")
}

/// GYM_MANAGEMENT master spec §65 — "INTERNAL NOTES (Owner-invisible)". Khác PartnerAuditLog:
/// đây là ghi chú TỰ DO giữa các admin ("đã gọi điện, hẹn tuần sau"), không phải nhật ký hành
/// động hệ thống — không có action/before-after nào để ghi. Không route/endpoint nào của
/// gym-owner (owner.routes.ts) được phép đọc bảng này; chỉ admin.routes.ts.
model PartnerInternalNote {
  id            String   @id @default(uuid())
  partnerId     String   @map("partner_id")
  authorAdminId String   @map("author_admin_id")
  text          String
  createdAt     DateTime @default(now()) @map("created_at")

  partner GymPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@map("partner_internal_notes")
}

/// Phase 5 — mức chiết khấu nền tảng CHUNG cho hoa hồng gói hội viên, có ngày hiệu lực.
/// Đổi mức = THÊM DÒNG MỚI với effectiveFrom tương lai, KHÔNG BAO GIỜ sửa dòng cũ — dòng
/// cũ là bằng chứng "hợp đồng nào từng áp dụng mức nào" một khi mức đã đổi.
///
/// ⚠️ Mức này (và commissionRateOverride của từng đối tác) vẫn bị kẹp ở sàn tối thiểu
/// hiện có của hệ thống (0.10 — xem membership.service.ts's PLATFORM_RATE, "floored at
/// 10%, same as PT contracts") tại thời điểm áp dụng. Đây là quyết định giữ nguyên có chủ
/// đích (đã hỏi và chốt), KHÔNG phải lỗi: một dòng ghi 0.05 vẫn hợp lệ để lưu trữ ý định
/// đàm phán, nhưng số tiền thực tế trích ra không bao giờ thấp hơn sàn.
model PlatformCommissionRate {
  id            String   @id @default(uuid())
  rate          Decimal  @db.Decimal(5, 4)
  effectiveFrom DateTime @map("effective_from")
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([effectiveFrom])
  @@map("platform_commission_rates")
}

/// Pháp nhân đối tác: sở hữu ĐÚNG MỘT thương hiệu, một hồ sơ, một ví. Hộ kinh doanh
/// nhỏ có đúng một tài khoản; chuỗi lớn thêm tài khoản MANAGER — cùng một mô hình,
/// khác nhau ở số tài khoản đăng nhập.
model GymPartner {
  id                      String                     @id @default(uuid())
  /// Tên pháp lý trên giấy phép — khác tên thương hiệu công khai (GymBrand.name).
  legalName               String                     @map("legal_name")
  partnerKind             GymPartnerKind             @default(BUSINESS) @map("partner_kind")
  taxCode                 String?                    @map("tax_code")
  businessLicenseNo       String?                    @map("business_license_no")
  /// Email đã trao đổi ban đầu — hồ sơ liên hệ của pháp nhân, KHÔNG phải thông tin
  /// đăng nhập (thông tin đó nằm ở auth-service, trỏ qua GymPartnerAccount.userId).
  /// Nullable vì các đối tác có sẵn trước phase này được backfill từ dữ liệu gym-service,
  /// nơi không hề lưu email; API tạo mới thì bắt buộc phải có.
  contactEmail            String?                    @map("contact_email")
  contactPhone            String?                    @map("contact_phone")
  status                  GymPartnerStatus           @default(PROSPECT)
  /// GYM_MANAGEMENT master spec §60 — trục thẩm định giấy tờ, tách khỏi `status` ở trên (xem
  /// doc comment của PartnerVerificationStatus). Cấp tài khoản OWNER (provisionOwnerAccount)
  /// đòi hỏi giá trị này phải là VERIFIED — thẩm định xong giấy tờ TRƯỚC khi cấp tài khoản,
  /// đúng thứ tự accept-flow của spec. Backfill: các đối tác đã qua provisioning từ trước khi
  /// cột này tồn tại (status khác PROSPECT) được coi là VERIFIED — họ đã được duyệt bằng quy
  /// trình cũ, gắn NOT_VERIFIED hồi tố sẽ khoá nhầm một chủ gym đang hoạt động thật.
  verificationStatus      PartnerVerificationStatus  @default(NOT_VERIFIED) @map("verification_status")
  /// Nội dung admin ghi khi chuyển NEEDS_INFO ("cần bổ sung gì") hoặc REJECTED ("vì sao từ
  /// chối thẩm định") — hiển thị cho đối tác biết chính xác cần làm gì tiếp theo.
  verificationNotes       String?                    @map("verification_notes")
  verifiedAt              DateTime?                  @map("verified_at")
  verifiedBy              String?                    @map("verified_by")
  /// Admin phụ trách hồ sơ này — thuần hiển thị/lọc ("việc của ai"), không phải quyền hạn:
  /// mọi admin vẫn thao tác được trên mọi hồ sơ, id trần không FK (cùng quy ước với ownerId).
  assignedAdminId         String?                    @map("assigned_admin_id")
  /// Bất biến "mỗi đối tác tối đa một thương hiệu" — cột đơn + unique index. Null cho
  /// tới khi chủ sở hữu tự đặt tên thương hiệu ở bước 3 của trình thiết lập lần đầu.
  brandId                 String?                    @unique @map("brand_id")
  /// Tỷ lệ riêng đã đàm phán; NULL = dùng mức chung (PlatformCommissionRate, Phase 5).
  /// Thêm cột từ bây giờ rẻ hơn sửa công thức tiền sau, kể cả khi chưa ai dùng.
  commissionRateOverride  Decimal?                   @map("commission_rate_override") @db.Decimal(5, 4)
  suspendedAt             DateTime?                  @map("suspended_at")
  suspendedReason         String?                    @map("suspended_reason")
  suspendedBy             String?                    @map("suspended_by")
  terminatedAt            DateTime?                  @map("terminated_at")
  terminationReason       String?                    @map("termination_reason")
  /// Phase 5 — lựa chọn xử lý hội viên còn hạn lúc chấm dứt hợp tác. Null cho tới khi
  /// chấm dứt; bắt buộc chọn một trong hai ngay tại màn xác nhận.
  terminationMemberPolicy TerminationMemberPolicy?   @map("termination_member_policy")
  /// Phase 4 — hồ sơ bị từ chối vẫn ở nguyên GymPartnerStatus.PROSPECT (không thêm status
  /// mới) nhưng có dấu vết để phân biệt "PROSPECT vì mới mở" với "PROSPECT vì đã từ chối,
  /// đang chờ mở lại". "Mở lại" chỉ đơn giản là xoá hai cột này.
  rejectedAt              DateTime?                  @map("rejected_at")
  rejectionReason         String?                    @map("rejection_reason")
  /// Phase 4 — "Điều khoản đã chốt" trước khi cấp tài khoản: số chi nhánh dự kiến + ghi
  /// chú. Tỷ lệ chiết khấu đã đàm phán dùng chung cột commissionRateOverride ở trên.
  expectedBranchCount     Int?                       @map("expected_branch_count")
  negotiationNotes        String?                    @map("negotiation_notes")
  // ── Phase 3: bước 3-4-5 của trình thiết lập lần đầu (chỉ OWNER phải hoàn tất) ──────
  // ── Hồ sơ tự đăng ký ──────────────────────────────────────────────────────────────
  /// Mọi dòng có từ trước là ADMIN_CREATED. SELF_SERVICE được đặt lúc bootstrap.
  source                  GymPartnerSource           @default(ADMIN_CREATED)
  /// Lúc ứng viên nộp hồ sơ (UNDER_REVIEW). Null khi đang ONBOARDING.
  submittedAt             DateTime?                  @map("submitted_at")
  representativeName      String?                    @map("representative_name")
  representativeRole      PartnerRepresentativeRole? @map("representative_role")
  businessScale           PartnerBusinessScale?      @map("business_scale")
  payoutBankName          String?                    @map("payout_bank_name")
  payoutBankAccountNumber String?                    @map("payout_bank_account_number")
  payoutBankAccountHolder String?                    @map("payout_bank_account_holder")
  termsAcceptedVersion    String?                    @map("terms_accepted_version")
  termsAcceptedAt         DateTime?                  @map("terms_accepted_at")
  createdBy               String?                    @map("created_by")
  createdAt               DateTime                   @default(now()) @map("created_at")
  updatedAt               DateTime                   @updatedAt @map("updated_at")

  accounts      GymPartnerAccount[]
  invitations   PartnerInvitation[]
  auditLogs     PartnerAuditLog[]
  documents     GymPartnerDocument[]
  contactLogs   GymPartnerContactLog[]
  internalNotes PartnerInternalNote[]
  reviewIssues  GymPartnerReviewIssue[]
  uploadIntents PartnerUploadIntent[]

  @@index([status])
  @@index([verificationStatus])
  @@index([assignedAdminId])
  @@map("gym_partners")
}

/// Một người, một tài khoản. `userId` trỏ tới auth-service (không FK xuyên service —
/// cùng quy ước với Gym.ownerId).
model GymPartnerAccount {
  id                    String               @id @default(uuid())
  partnerId             String               @map("partner_id")
  /// Bất biến "một userId chỉ thuộc tối đa một đối tác" — unique ở cấp DB, không chỉ
  /// kiểm ở tầng service.
  userId                String               @unique @map("user_id")
  role                  PartnerAccountRole
  /// MANAGER bị giới hạn ở đúng các chi nhánh này (bất biến: phải có ít nhất một —
  /// xem CHECK constraint trong migration). OWNER để trống = toàn bộ chi nhánh.
  scopedGymIds          String[]             @map("scoped_gym_ids")
  status                PartnerAccountStatus @default(INVITED)
  invitedBy             String?              @map("invited_by")
  invitedAt             DateTime             @default(now()) @map("invited_at")
  activatedAt           DateTime?            @map("activated_at")
  revokedAt             DateTime?            @map("revoked_at")
  revokedReason         String?              @map("revoked_reason")
  /// Phase 3 bước 2 — điện thoại liên hệ CỦA CHÍNH NGƯỜI đăng nhập này, khác
  /// GymPartner.contactPhone (đầu mối liên hệ chung của pháp nhân).
  contactPhone          String?              @map("contact_phone")
  /// Set khi hoàn tất đúng số bước bắt buộc theo vai trò (OWNER: cả 5 bước; MANAGER: chỉ
  /// bước 1-2). Middleware requireOnboardingComplete chặn mọi route /owner/* khác cho tới
  /// khi cột này khác null.
  onboardingCompletedAt DateTime?            @map("onboarding_completed_at")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  partner GymPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, status])
  @@map("gym_partner_accounts")
}

/// Thư mời có hạn. ⚠️ Không bao giờ gửi mật khẩu qua email — mật khẩu gửi đi là một
/// credential sống trôi nổi vô thời hạn, và nếu người nhận không bao giờ đăng nhập thì
/// không ai biết. Gửi link mời hết hạn được, người nhận tự đặt mật khẩu.
model PartnerInvitation {
  id           String                  @id @default(uuid())
  partnerId    String                  @map("partner_id")
  email        String
  role         PartnerAccountRole
  /// Chi nhánh được gán sẵn cho MANAGER ngay lúc mời — chuyển thẳng sang
  /// GymPartnerAccount.scopedGymIds khi chấp nhận, để người mời không phải gán lại.
  scopedGymIds String[]                @map("scoped_gym_ids")
  /// ⚠️ LƯU BĂM (sha256 hex), KHÔNG LƯU TOKEN GỐC. Token gốc chỉ tồn tại một lần trong
  /// phản hồi của createInvitation để gửi email; rò rỉ CSDL không cho phép ai nhận thư
  /// mời của người khác.
  tokenHash    String                  @unique @map("token_hash")
  expiresAt    DateTime                @map("expires_at")
  status       PartnerInvitationStatus @default(PENDING)
  sentCount    Int                     @default(1) @map("sent_count")
  createdBy    String?                 @map("created_by")
  createdAt    DateTime                @default(now()) @map("created_at")
  acceptedAt   DateTime?               @map("accepted_at")

  partner GymPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, status])
  @@index([email])
  @@map("partner_invitations")
}

/// Phase 4 — giấy tờ thẩm định. Mỗi mục: tệp + trạng thái + ai kiểm + lúc nào, đúng đặc
/// tả mục 4.1. `required=false` cho các mục 🟡 (mã số thuế, ảnh thực địa, PCCC).
model GymPartnerDocument {
  id         String                @id @default(uuid())
  partnerId  String                @map("partner_id")
  docType    PartnerDocumentType   @map("doc_type")
  required   Boolean               @default(true)
  fileUrl    String?               @map("file_url")
  /// KHÔNG CÒN GHI. Từ 20260921 tệp nằm ở `files` (một giấy tờ có thể nhiều tệp: CCCD hai mặt, giấy
  /// phép nhiều trang); migration đã chép khoá cũ sang đó và đặt cột này về NULL. Giữ cột, không xoá.
  fileKey    String?               @map("file_key")
  mimeType   String?               @map("mime_type")
  sizeBytes  Int?                  @map("size_bytes")
  uploadedBy String?               @map("uploaded_by")
  /// Tăng mỗi lần ứng viên thay tệp (khoá cũ được giữ trong PartnerAuditLog.metadata).
  version    Int                   @default(1)
  /// Lý do admin yêu cầu cập nhật (status = REJECTED, nhãn UI "Cần cập nhật").
  reviewNote String?               @map("review_note")
  status     PartnerDocumentStatus @default(PENDING)
  /// Người/lúc DUYỆT (chấp nhận hoặc yêu cầu cập nhật) — không đổi nghĩa so với trước.
  verifiedBy String?               @map("verified_by")
  verifiedAt DateTime?             @map("verified_at")
  /// Cho giấy phép kinh doanh/PCCC — nguồn cho mục "giấy phép sắp hết hạn" ở hàng đợi
  /// việc cần làm (Phase 4 mục 4.2).
  expiresAt  DateTime?             @map("expires_at")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  partner GymPartner               @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  files   GymPartnerDocumentFile[]

  @@unique([partnerId, docType])
  @@index([partnerId])
  @@index([expiresAt])
  @@map("gym_partner_documents")
}

/// Một tệp của một giấy tờ đối tác (ảnh mặt trước/mặt sau, từng trang). Admin vẫn duyệt theo GIẤY TỜ
/// (GymPartnerDocument.status), không theo từng tệp. Khoá do server sinh, bucket riêng tư.
model GymPartnerDocumentFile {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  fileKey    String   @map("file_key")
  mimeType   String   @map("mime_type")
  sizeBytes  Int?     @map("size_bytes")
  uploadedBy String?  @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  document GymPartnerDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("gym_partner_document_files")
}

/// Vấn đề admin nêu trên hồ sơ tự đăng ký, theo mục. Vòng đời OPEN → RESUBMITTED (ứng viên
/// đánh dấu "đã cập nhật") → RESOLVED (chỉ ADMIN đóng). Nộp lại hồ sơ KHÔNG đóng vấn đề nào.
model GymPartnerReviewIssue {
  id            String                   @id @default(uuid())
  partnerId     String                   @map("partner_id")
  category      PartnerReviewCategory
  message       String
  status        PartnerReviewIssueStatus @default(OPEN)
  createdBy     String                   @map("created_by")
  createdAt     DateTime                 @default(now()) @map("created_at")
  resubmitNote  String?                  @map("resubmit_note")
  resubmittedAt DateTime?                @map("resubmitted_at")
  /// Lời nhắn của admin khi mở lại một vấn đề chưa được sửa đúng (status quay về OPEN).
  adminFollowUp String?                  @map("admin_follow_up")
  resolvedBy    String?                  @map("resolved_by")
  resolvedAt    DateTime?                @map("resolved_at")

  partner GymPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, status])
  @@map("gym_partner_review_issues")
}

/// Một lần xin phép tải lên. Khoá đối tượng do SERVER sinh và gắn với partner; client chỉ
/// nhận uploadId và chỉ xác nhận (confirm) được intent của CHÍNH partner đó — không có
/// đường nào gắn một khoá S3 tuỳ ý hay của partner khác vào hồ sơ.
model PartnerUploadIntent {
  id            String               @id @default(uuid())
  partnerId     String               @map("partner_id")
  kind          PartnerUploadKind
  docType       PartnerDocumentType? @map("doc_type")
  gymId         String?              @map("gym_id")
  photoCategory GymPhotoCategory?    @map("photo_category")
  objectKey     String               @unique @map("object_key")
  contentType   String               @map("content_type")
  maxBytes      Int                  @map("max_bytes")
  createdBy     String               @map("created_by")
  expiresAt     DateTime             @map("expires_at")
  confirmedAt   DateTime?            @map("confirmed_at")
  createdAt     DateTime             @default(now()) @map("created_at")

  partner GymPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, kind])
  @@map("partner_upload_intents")
}

/// Phase 4 — nhật ký trao đổi: mỗi email, cuộc gọi, cam kết đều ghi lại kèm ngày và người
/// thực hiện. Tách khỏi PartnerAuditLog (bảng đó là hành động HỆ THỐNG tự động sinh ra khi
/// admin bấm nút; bảng này là ghi chú THỦ CÔNG admin tự nhập về một lần trao đổi ngoài
/// đời) — gộp chung sẽ lẫn lộn giữa "hệ thống ghi" và "người tự thuật lại".
model GymPartnerContactLog {
  id         String                @id @default(uuid())
  partnerId  String                @map("partner_id")
  channel    PartnerContactChannel
  note       String
  occurredAt DateTime              @default(now()) @map("occurred_at")
  createdBy  String                @map("created_by")
  createdAt  DateTime              @default(now()) @map("created_at")

  partner GymPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, occurredAt])
  @@map("gym_partner_contact_logs")
}

/// A chain: one owner, one name, many physical locations (Gym rows below). Optional —
/// a gym created without ever choosing a brand stays exactly as it always has, a single
/// standalone location with `brandId = null`. Client search groups branches under their
/// brand's card; a gym with no brand is just its own card, same as before this feature.
model GymBrand {
  id           String   @id @default(uuid())
  ownerId      String   @map("owner_id")
  /// Vòng 4 / Phase C1 — `name` stays the owner's freely-editable working value (unchanged
  /// role from before this phase); `approvedName`/`pendingName` are a moderation overlay only
  /// PUBLIC pages read. `approvedName` is null until an admin approves this brand's FIRST
  /// branch (gymService.setStatus backfills it then, same trigger C1 specifies — no new admin
  /// action needed for the first approval). Every later rename sets `pendingName` only,
  /// leaving `approvedName` untouched until the dedicated "Duyệt đổi tên thương hiệu" admin
  /// action (brandService.approveRename) promotes it. Null pendingName means "nothing pending
  /// — name is exactly what's approved."
  name         String
  approvedName String?  @map("approved_name")
  pendingName  String?  @map("pending_name")
  description  String?
  /// Khoá đối tượng S3 của logo (hồ sơ tự đăng ký). Chưa có luồng tải logo thì để null.
  logoKey      String?  @map("logo_key")
  /// Trang mạng xã hội của THƯƠNG HIỆU (không phải từng chi nhánh) — hiện ở "Chi tiết" khi khách xem
  /// phòng gym. Chỉ nhận https + đúng tên miền của từng mạng (application.schemas.ts socialLinksSchema).
  facebookUrl  String?  @map("facebook_url")
  instagramUrl String?  @map("instagram_url")
  tiktokUrl    String?  @map("tiktok_url")
  youtubeUrl   String?  @map("youtube_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  branches Gym[]
  plans    GymMembershipPlan[]

  /// Bất biến "1 Owner = đúng 1 Brand" ở cấp DB (trước đây chỉ GymPartner.brandId là unique).
  @@unique([ownerId])
  @@map("gym_brands")
}

model Gym {
  id                 String               @id @default(uuid())
  ownerId            String               @map("owner_id")
  /// Which brand this location belongs to, if any. This branch's own checkins, reviews, and
  /// affiliations stay keyed to this row exactly as for a standalone gym — brand is purely a
  /// grouping label for search and owner navigation EXCEPT for membership plans, which moved
  /// to brand-level entirely (see GymMembershipPlan's own doc comment): a branch has no plans
  /// of its own any more, only the brand does.
  brandId            String?              @map("brand_id")
  /// Vòng 4 / Phase C2 — same approvedX/pendingX overlay as GymBrand.name above, applied to
  /// name AND address (the only two fields that need re-approval; every other field — phone,
  /// email, city, description, hours — stays freely editable with no moderation at all).
  /// `name`/`address` remain the live working values every non-public consumer already reads
  /// (checkin receipts, membership listings, the owner's own dashboard); only the public
  /// discovery endpoints (gymService.listApproved/getApprovedById) substitute approvedName/
  /// approvedAddress in their place. `approvedName`/`approvedAddress` are backfilled from
  /// name/address the first time this gym's `status` is set to APPROVED (mirrors the brand's
  /// first-branch-approval trigger); every edit afterwards only moves pendingName/
  /// pendingAddress until the "Duyệt đổi tên/địa chỉ" admin action (gymService.approveRename)
  /// promotes them.
  name               String
  approvedName       String?              @map("approved_name")
  pendingName        String?              @map("pending_name")
  /// GYM_MANAGEMENT master spec §60/§62 — ghi chú theo TỪNG TRƯỜNG khi admin "Yêu cầu chỉnh
  /// sửa" thay vì duyệt/từ chối thẳng. Chỉ áp dụng cho hai trường trọng yếu (name/address) —
  /// đúng những trường có cơ chế pending* ở trên. Khác `rejectReason`-kiểu-cũ (không tồn tại
  /// ở model này) ở chỗ đây KHÔNG từ chối gì cả: gym vẫn giữ nguyên `status` hiện tại (không
  /// lùi về PENDING_REVIEW — xem gymService.requestChanges), chỉ đơn thuần "còn treo, chờ chủ
  /// gym sửa lại đúng các mục này". Xoá khi mục tương ứng được duyệt hoặc thay bằng giá trị
  /// pending mới.
  pendingNameNote    String?              @map("pending_name_note")
  pendingAddressNote String?              @map("pending_address_note")
  /// Set khi admin vừa yêu cầu chỉnh sửa — dùng để xếp hàng đợi "chủ gym cần xem" và để phân
  /// biệt "mới sửa, chưa ai xem lại" với "đã sửa, admin đã duyệt". Null nghĩa là không có yêu
  /// cầu chỉnh sửa nào đang treo.
  changesRequestedAt DateTime?            @map("changes_requested_at")
  changesRequestedBy String?              @map("changes_requested_by")
  description        String?
  address            String
  approvedAddress    String?              @map("approved_address")
  pendingAddress     String?              @map("pending_address")
  city               String?
  /// Denormalized reference vào bảng VietnamProvince/VietnamWard của user-service — không
  /// FK xuyên service (cùng quy ước với `ownerId`). Dùng để lọc "theo tỉnh/thành phố" ở
  /// trang tìm phòng gym, thay cho việc so khớp chuỗi tự do trên `city` (đã xác nhận thực
  /// tế: chủ gym gõ "HCMC" lẫn "Test City" — không thể so khớp một cách đáng tin cậy).
  provinceCode       Int?                 @map("province_code")
  wardCode           Int?                 @map("ward_code")
  /// Toạ độ chi nhánh, để tính khoảng cách tới khách đang tìm kiếm và sắp xếp gần nhất lên
  /// đầu. Chủ gym tự bấm "Dùng vị trí hiện tại" lúc tạo/sửa chi nhánh — không tích hợp
  /// geocoding API trả phí nào (quyết định đã hỏi và chốt).
  latitude           Float?
  longitude          Float?
  /// GYM_BRANCH_FORM_SPEC.md §14 — optional free-text directions on top of the formal
  /// address ("Tầng 3 tòa nhà ABC, lối vào phía bên trái"). Never treated as part of the
  /// material name/address pair — editing it never triggers admin re-review.
  locationNote       String?              @map("location_note")
  /// GYM_BRANCH_FORM_SPEC.md, Phase 3 — Bước 4. Free edit, không có cơ chế duyệt lại như
  /// name/address (không phải trường "trọng yếu" theo §60/§62's own scope).
  facilities         GymFacility[]        @default([])
  phone              String?
  email              String?
  status             GymStatus            @default(PENDING_REVIEW)
  /// GYM_BRANCH_FORM_SPEC.md Phase 1 — the "Add Branch" wizard's server-trusted resume
  /// point, only meaningful while status is DRAFT ("remember current wizard step" — do not
  /// restart from Step 1). Deliberately NOT used to gate anything (a client jumping straight
  /// to step 7 with an incomplete draft just fails the submit-time validation) — it only
  /// decides where the wizard opens back up.
  wizardStep         Int?                 @map("wizard_step")
  /// Vòng 4 / Phase C3 — independent from `status` (moderation: is this gym allowed to exist
  /// on the platform at all) on purpose. This is the OWNER's own "are we open for business
  /// right now" switch — a SUSPENDED gym is never OPEN-gated regardless of this value (both
  /// axes must pass), but an APPROVED gym can still be temporarily/permanently closed by its
  /// own owner without an admin ever touching `status`.
  operationalStatus  GymOperationalStatus @default(OPEN) @map("operational_status")
  closureReason      String?              @map("closure_reason")
  /// GYM_MANAGEMENT master spec §61 — ngày dự kiến mở lại, do chủ gym tự nhập lúc đóng cửa
  /// tạm thời. Thuần hiển thị (hàng đợi admin + banner cho khách tìm kiếm) — KHÔNG có job nào
  /// tự động mở lại gym vào ngày này; chủ gym vẫn phải tự bấm "Mở lại".
  expectedReopenAt   DateTime?            @map("expected_reopen_at")
  closedAt           DateTime?            @map("closed_at")
  reopenedAt         DateTime?            @map("reopened_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  brand           GymBrand?               @relation(fields: [brandId], references: [id])
  memberships     GymMembershipContract[]
  affiliations    GymTrainerAffiliation[]
  reviews         GymReview[]
  collaborations  GymPtCollaboration[]
  complaints      GymComplaint[]
  operatingHours  GymOperatingHours[]
  photos          GymPhoto[]
  branchDocuments GymBranchDocument[]
  reviewIssues    GymBranchReviewIssue[]

  @@index([status])
  @@index([operationalStatus])
  @@index([ownerId])
  @@index([brandId])
  /// Khớp với index đã tạo tay ở migration 20260908040000 — thiếu dòng này khiến
  /// `prisma migrate diff` coi index đã có trong CSDL là "thừa, cần xoá" (phát hiện khi
  /// soạn migration Phase 1 của master spec quản lý gym).
  @@index([provinceCode])
  @@map("gyms")
}

/// One owner, one brand (see GymBrand) — a plan is sold BY THE BRAND, not any one branch, so a
/// client who buys it can check in (and draw down the shared visitLimit) at any of the
/// brand's branches. Previously `gymId`-scoped: a plan belonged to exactly one gym, and a
/// membership bought there only worked at that same gym. GymMembershipContract still carries
/// its own `gymId` (which branch the client actually checked out at) — that stays gym-level,
/// purely for revenue/collaboration/referral attribution; only the PLAN definition and
/// check-in eligibility (checkin.service.ts) moved to brand-level. See migration
/// 20260907000000_scope_membership_plans_to_brand for how existing plans (and any standalone
/// gym that had one) were backfilled.
model GymMembershipPlan {
  id           String                  @id @default(uuid())
  brandId      String                  @map("brand_id")
  name         String
  description  String?
  price        Decimal                 @db.Decimal(12, 2)
  durationDays Int                     @map("duration_days")
  visitLimit   Int?                    @map("visit_limit")
  status       GymMembershipPlanStatus @default(ACTIVE)
  /// Optional marketing window: the plan can only be PURCHASED while now is inside
  /// [saleStartAt, saleEndAt]. Distinct from durationDays, which is how long a membership
  /// lasts once bought — the sale window closing never shortens a membership already sold.
  /// Both null (the common case) means always on sale while status is ACTIVE.
  saleStartAt  DateTime?               @map("sale_start_at")
  saleEndAt    DateTime?               @map("sale_end_at")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  brand       GymBrand                @relation(fields: [brandId], references: [id])
  memberships GymMembershipContract[]

  @@index([brandId, status])
  @@map("gym_membership_plans")
}

model GymMembershipContract {
  id                   String                      @id @default(uuid())
  gymId                String                      @map("gym_id")
  planId               String                      @map("plan_id")
  clientId             String                      @map("client_id")
  status               GymMembershipContractStatus @default(PENDING_PAYMENT)
  paymentTxnId         String?                     @map("payment_txn_id")
  startDate            DateTime?                   @map("start_date")
  endDate              DateTime?                   @map("end_date")
  priceAtPurchase      Decimal                     @map("price_at_purchase") @db.Decimal(12, 2)
  durationDaysSnapshot Int                         @map("duration_days_snapshot")
  totalVisits          Int?                        @map("total_visits")
  usedVisits           Int                         @default(0) @map("used_visits")
  /// Stamped once the pending-bucket payout (gym + platform + any un-clawed referral
  /// commission) has been released to AVAILABLE. Set by the payout sweep on natural
  /// expiry, or immediately on client self-cancel / admin refund — see docs/money-flow.md.
  /// Guards membership-release against double-releasing the same membership.
  payoutReleasedAt     DateTime?                   @map("payout_released_at")
  /// True when the client confirmed purchase after being shown a warning that they already
  /// hold an active membership at a different gym — evidence against "I didn't know I still
  /// had one elsewhere" disputes.
  multiGymWarned       Boolean                     @default(false) @map("multi_gym_warned")
  /// Money-flow plan 1.7: set right after `refundByAdmin`'s referral-clawback step commits
  /// its LOCAL bookkeeping (`GymMembershipReferral.clawedBack`). That local increment is not
  /// itself idempotent — payment-service's own idempotency guard (plan 1.1) means a retried
  /// `clawbackReferral` call just returns the FIRST attempt's cached amount rather than
  /// re-debiting anything, but gym-service would still add that cached amount onto
  /// `clawedBack` a second time if it re-entered the branch. `refundByAdmin` is one-shot per
  /// membership (blocked once status flips to CANCELLED), so this flag only ever needs to
  /// answer one question: did THIS refund's clawback step already run.
  refundClawbackDone   Boolean                     @default(false) @map("refund_clawback_done")
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")

  gym      Gym                    @relation(fields: [gymId], references: [id])
  plan     GymMembershipPlan      @relation(fields: [planId], references: [id])
  checkIns GymCheckIn[]
  referral GymMembershipReferral?

  @@index([clientId, status])
  @@index([gymId, status])
  @@map("gym_membership_contracts")
}

model GymTrainerAffiliation {
  id             String                @id @default(uuid())
  gymId          String                @map("gym_id")
  ptId           String                @map("pt_id")
  status         AffiliationStatus     @default(PENDING)
  employmentType AffiliationEmployment @default(FREELANCE) @map("employment_type")
  visibility     GymTrainerVisibility  @default(PUBLIC)
  commissionRate Decimal?              @map("commission_rate") @db.Decimal(5, 4)
  invitedBy      String?               @map("invited_by")
  joinedAt       DateTime?             @map("joined_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  gym Gym @relation(fields: [gymId], references: [id])

  @@unique([gymId, ptId])
  @@index([ptId, status])
  @@index([gymId, status])
  @@map("gym_trainer_affiliations")
}

// ─── Gym Check-in (member scans in at the gym) ────────────────────────
model GymCheckIn {
  id           String   @id @default(uuid())
  membershipId String   @map("membership_id")
  gymId        String   @map("gym_id")
  clientId     String   @map("client_id")
  checkedInBy  String   @map("checked_in_by") // owner userId who scanned
  createdAt    DateTime @default(now()) @map("created_at")

  membership GymMembershipContract @relation(fields: [membershipId], references: [id])

  @@index([gymId, createdAt])
  @@index([membershipId, createdAt])
  @@map("gym_check_ins")
}

// ─── Gym Review / Rating (one per member per gym) ─────────────────────
model GymReview {
  id        String   @id @default(uuid())
  gymId     String   @map("gym_id")
  clientId  String   @map("client_id")
  rating    Int // 1–5
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gym Gym @relation(fields: [gymId], references: [id])

  @@unique([gymId, clientId])
  @@index([gymId])
  @@map("gym_reviews")
}

// ─── PT ↔ gym collaboration (revenue-share negotiation) ───────────────

enum CollaborationStatus {
  PENDING // waiting on the other side's first answer
  COUNTERED // the other side proposed different rates; the ball is back
  ACCEPTED // terms agreed and locked
  REJECTED // turned down outright
  EXPIRED // ran out of time or out of negotiating rounds
  TERMINATED // the partnership was ended after it had been accepted
}

enum CollaborationParty {
  PT
  GYM
}

/// A revenue-share agreement between a trainer and a gym.
///
/// A PT affiliated with a gym trains clients on the gym's floor and checks in free; in return
/// the gym takes a cut of the contracts that PT signs there. Both sides have to agree on the
/// split, so this row carries the negotiation as well as the outcome — each counter-offer
/// overwrites the proposed rates and flips `proposedBy`, so whose turn it is is never
/// ambiguous.
///
/// The rates here are a TEMPLATE, not the source of truth for any contract. When a contract is
/// signed it copies them onto itself (see docs/money-flow.md §12); renegotiating afterwards
/// leaves existing contracts on the terms their parties actually agreed to.
model GymPtCollaboration {
  id       String @id @default(uuid())
  gymId    String @map("gym_id")
  ptUserId String @map("pt_user_id")

  /// Currently on the table. Must satisfy proposedPtRate + proposedGymRate + platformRate = 1.
  proposedPtRate  Decimal @map("proposed_pt_rate") @db.Decimal(6, 4)
  proposedGymRate Decimal @map("proposed_gym_rate") @db.Decimal(6, 4)
  /// Stored so the accepted row is a complete snapshot rather than half a rate table.
  platformRate    Decimal @default("0.10") @map("platform_rate") @db.Decimal(6, 4)

  status     CollaborationStatus @default(PENDING)
  /// Who made the offer currently on the table — i.e. whose turn it is NOT.
  proposedBy CollaborationParty  @map("proposed_by")
  /// Counter-offers so far. Capped so a negotiation cannot run forever.
  round      Int                 @default(1)
  expiresAt  DateTime            @map("expires_at")

  acceptedAt   DateTime? @map("accepted_at")
  terminatedAt DateTime? @map("terminated_at")
  terminatedBy String?   @map("terminated_by")
  /// Vòng 4 / Phase E3 — when set, this row is winding down: status STAYS 'ACCEPTED' (so
  /// affiliation/roster display is unaffected) until this date, but activeRates() already
  /// refuses NEW referral/rate lookups against it the moment this is set, regardless of the
  /// date — "new collaborations blocked immediately, running contracts continue until
  /// effectiveAt". Null = no pending termination. A lazy check (finalizeIfEffective, mirroring
  /// expireIfStale above) flips status -> TERMINATED once effectiveAt has passed. terminate()
  /// with no explicit date still terminates immediately (sets effectiveAt = now).
  effectiveAt  DateTime? @map("effective_at")
  note         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gym Gym @relation(fields: [gymId], references: [id])

  @@index([gymId, status])
  @@index([ptUserId, status])
  @@map("gym_pt_collaborations")
}

/// Commission owed to a PT for introducing a client who bought a gym membership.
///
/// Paid out of the GYM's share, never the platform's — the platform did no introducing. The
/// `clawedBack` column exists because a refunded membership must reverse the commission in
/// proportion; a referral system that pays on purchase but forgets to reclaim on refund leaks
/// money on every cancellation.
model GymMembershipReferral {
  id                   String    @id @default(uuid())
  membershipContractId String    @unique @map("membership_contract_id")
  gymId                String    @map("gym_id")
  referrerPtUserId     String    @map("referrer_pt_user_id")
  rate                 Decimal   @db.Decimal(6, 4)
  /// Gross commission earned at purchase time.
  amount               Decimal   @db.Decimal(14, 2)
  /// Reversed so far, following partial refunds of the membership.
  clawedBack           Decimal   @default(0) @map("clawed_back") @db.Decimal(14, 2)
  status               String    @default("PENDING")
  releasedAt           DateTime? @map("released_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  membershipContract GymMembershipContract @relation(fields: [membershipContractId], references: [id])

  @@index([referrerPtUserId, status])
  @@index([gymId])
  @@map("gym_membership_referrals")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GymStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum GymMembershipPlanStatus {
  ACTIVE
  INACTIVE
}

enum GymMembershipContractStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum AffiliationStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum AffiliationEmployment {
  IN_HOUSE
  FREELANCE
  PARTNER
}

enum GymTrainerVisibility {
  PUBLIC
  INTERNAL_ONLY
}

model Gym {
  id            String    @id @default(uuid())
  ownerId       String    @map("owner_id")
  name          String
  description   String?
  address       String
  city          String?
  phone         String?
  email         String?
  status        GymStatus @default(PENDING_REVIEW)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  plans        GymMembershipPlan[]
  memberships  GymMembershipContract[]
  affiliations   GymTrainerAffiliation[]
  reviews        GymReview[]
  collaborations GymPtCollaboration[]

  @@index([status])
  @@index([ownerId])
  @@map("gyms")
}

model GymMembershipPlan {
  id           String                   @id @default(uuid())
  gymId        String                   @map("gym_id")
  name         String
  description  String?
  price        Decimal                  @db.Decimal(12, 2)
  durationDays Int                      @map("duration_days")
  visitLimit   Int?                     @map("visit_limit")
  status       GymMembershipPlanStatus  @default(ACTIVE)
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  gym         Gym                     @relation(fields: [gymId], references: [id])
  memberships GymMembershipContract[]

  @@index([gymId, status])
  @@map("gym_membership_plans")
}

model GymMembershipContract {
  id                   String                       @id @default(uuid())
  gymId                String                       @map("gym_id")
  planId               String                       @map("plan_id")
  clientId             String                       @map("client_id")
  status               GymMembershipContractStatus  @default(PENDING_PAYMENT)
  paymentTxnId         String?                      @map("payment_txn_id")
  startDate            DateTime?                    @map("start_date")
  endDate              DateTime?                     @map("end_date")
  priceAtPurchase      Decimal                      @db.Decimal(12, 2) @map("price_at_purchase")
  durationDaysSnapshot Int                          @map("duration_days_snapshot")
  totalVisits          Int?                         @map("total_visits")
  usedVisits           Int                          @default(0) @map("used_visits")
  /// Stamped once the pending-bucket payout (gym + platform + any un-clawed referral
  /// commission) has been released to AVAILABLE. Set by the payout sweep on natural
  /// expiry, or immediately on client self-cancel / admin refund — see docs/money-flow.md.
  /// Guards membership-release against double-releasing the same membership.
  payoutReleasedAt     DateTime?                    @map("payout_released_at")
  /// True when the client confirmed purchase after being shown a warning that they already
  /// hold an active membership at a different gym — evidence against "I didn't know I still
  /// had one elsewhere" disputes.
  multiGymWarned       Boolean                      @default(false) @map("multi_gym_warned")
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")

  gym  Gym               @relation(fields: [gymId], references: [id])
  plan GymMembershipPlan @relation(fields: [planId], references: [id])
  checkIns GymCheckIn[]
  referral GymMembershipReferral?

  @@index([clientId, status])
  @@index([gymId, status])
  @@map("gym_membership_contracts")
}

model GymTrainerAffiliation {
  id             String                @id @default(uuid())
  gymId          String                @map("gym_id")
  ptId           String                @map("pt_id")
  status         AffiliationStatus     @default(PENDING)
  employmentType AffiliationEmployment @default(FREELANCE) @map("employment_type")
  visibility     GymTrainerVisibility  @default(PUBLIC)
  commissionRate Decimal?              @db.Decimal(5, 4) @map("commission_rate")
  invitedBy      String?               @map("invited_by")
  joinedAt       DateTime?             @map("joined_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  gym Gym @relation(fields: [gymId], references: [id])

  @@unique([gymId, ptId])
  @@index([ptId, status])
  @@index([gymId, status])
  @@map("gym_trainer_affiliations")
}

// ─── Gym Check-in (member scans in at the gym) ────────────────────────
model GymCheckIn {
  id           String   @id @default(uuid())
  membershipId String   @map("membership_id")
  gymId        String   @map("gym_id")
  clientId     String   @map("client_id")
  checkedInBy  String   @map("checked_in_by") // owner userId who scanned
  createdAt    DateTime @default(now()) @map("created_at")

  membership GymMembershipContract @relation(fields: [membershipId], references: [id])

  @@index([gymId, createdAt])
  @@index([membershipId, createdAt])
  @@map("gym_check_ins")
}

// ─── Gym Review / Rating (one per member per gym) ─────────────────────
model GymReview {
  id        String   @id @default(uuid())
  gymId     String   @map("gym_id")
  clientId  String   @map("client_id")
  rating    Int // 1–5
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gym Gym @relation(fields: [gymId], references: [id])

  @@unique([gymId, clientId])
  @@index([gymId])
  @@map("gym_reviews")
}

// ─── PT ↔ gym collaboration (revenue-share negotiation) ───────────────

enum CollaborationStatus {
  PENDING   // waiting on the other side's first answer
  COUNTERED // the other side proposed different rates; the ball is back
  ACCEPTED  // terms agreed and locked
  REJECTED  // turned down outright
  EXPIRED   // ran out of time or out of negotiating rounds
  TERMINATED // the partnership was ended after it had been accepted
}

enum CollaborationParty {
  PT
  GYM
}

/// A revenue-share agreement between a trainer and a gym.
///
/// A PT affiliated with a gym trains clients on the gym's floor and checks in free; in return
/// the gym takes a cut of the contracts that PT signs there. Both sides have to agree on the
/// split, so this row carries the negotiation as well as the outcome — each counter-offer
/// overwrites the proposed rates and flips `proposedBy`, so whose turn it is is never
/// ambiguous.
///
/// The rates here are a TEMPLATE, not the source of truth for any contract. When a contract is
/// signed it copies them onto itself (see docs/money-flow.md §12); renegotiating afterwards
/// leaves existing contracts on the terms their parties actually agreed to.
model GymPtCollaboration {
  id              String              @id @default(uuid())
  gymId           String              @map("gym_id")
  ptUserId        String              @map("pt_user_id")

  /// Currently on the table. Must satisfy proposedPtRate + proposedGymRate + platformRate = 1.
  proposedPtRate  Decimal             @db.Decimal(6, 4) @map("proposed_pt_rate")
  proposedGymRate Decimal             @db.Decimal(6, 4) @map("proposed_gym_rate")
  /// Stored so the accepted row is a complete snapshot rather than half a rate table.
  platformRate    Decimal             @default("0.10") @db.Decimal(6, 4) @map("platform_rate")

  status          CollaborationStatus @default(PENDING)
  /// Who made the offer currently on the table — i.e. whose turn it is NOT.
  proposedBy      CollaborationParty  @map("proposed_by")
  /// Counter-offers so far. Capped so a negotiation cannot run forever.
  round           Int                 @default(1)
  expiresAt       DateTime            @map("expires_at")

  acceptedAt      DateTime?           @map("accepted_at")
  terminatedAt    DateTime?           @map("terminated_at")
  terminatedBy    String?             @map("terminated_by")
  note            String?

  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  gym Gym @relation(fields: [gymId], references: [id])

  @@index([gymId, status])
  @@index([ptUserId, status])
  @@map("gym_pt_collaborations")
}

/// Commission owed to a PT for introducing a client who bought a gym membership.
///
/// Paid out of the GYM's share, never the platform's — the platform did no introducing. The
/// `clawedBack` column exists because a refunded membership must reverse the commission in
/// proportion; a referral system that pays on purchase but forgets to reclaim on refund leaks
/// money on every cancellation.
model GymMembershipReferral {
  id                   String    @id @default(uuid())
  membershipContractId String    @unique @map("membership_contract_id")
  gymId                String    @map("gym_id")
  referrerPtUserId     String    @map("referrer_pt_user_id")
  rate                 Decimal   @db.Decimal(6, 4)
  /// Gross commission earned at purchase time.
  amount               Decimal   @db.Decimal(14, 2)
  /// Reversed so far, following partial refunds of the membership.
  clawedBack           Decimal   @default(0) @db.Decimal(14, 2) @map("clawed_back")
  status               String    @default("PENDING")
  releasedAt           DateTime? @map("released_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  membershipContract GymMembershipContract @relation(fields: [membershipContractId], references: [id])

  @@index([referrerPtUserId, status])
  @@index([gymId])
  @@map("gym_membership_referrals")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProviderType {
  MOCK
  VNPAY
  MOMO
  ZALOPAY
  PAYOS
  STRIPE
  MANUAL_BANK_TRANSFER
}

enum PartnerType {
  GYM
  PT
  CLIENT
}

enum CommissionStatus {
  PENDING
  SETTLED
  CANCELLED
}

enum PurposeType {
  GYM_MEMBERSHIP
  PT_CONTRACT
  GYM_PT_COMBO
  WALLET_TOPUP
  REFUND
  TRAINING_PACKAGE_PURCHASE
  PERSONALIZED_SERVICE_PURCHASE
  /// Money-flow plan 5.3: the dedicated PaymentTransaction row markPaid creates for a
  /// WithdrawalRequest payout. Outbound money has no originating gateway PaymentTransaction
  /// to reuse the way REFUND reuses the original purchase's — WalletLedgerEntry.transactionId
  /// is a hard FK, so a payout needs a row of its own to point at.
  WITHDRAWAL
}

enum WalletOwnerType {
  CLIENT
  PT
  GYM
  PLATFORM
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

/// Which of a wallet's three balances an entry moved. Releasing money from PENDING to
/// AVAILABLE is written as two entries sharing one transactionId: a PENDING debit and an
/// AVAILABLE credit, so the ledger stays double-entry and the release is auditable.
/// P0 cluster F: LOCKED added — a wallet's already-unused `lockedBalance` column finally gets
/// a ledger-writing path. A withdrawal request approval moves AVAILABLE -> LOCKED (a hard
/// reservation a later clawback/refund cannot reach, since those only ever debit AVAILABLE);
/// the actual payout later debits LOCKED (+ ESCROW); a rejection after approval moves LOCKED
/// back to AVAILABLE.
///
/// FH-9: HOLDBACK added - the PT's EARNED-but-not-yet-withdrawable money for the contracts that carry a PT financial holdback
/// (10% of the PT's expected income on that contract, held until the contract has ended and is reconciled). It is a claim of the PT
/// on ESCROW exactly like AVAILABLE, but nothing withdraws from it and no per-session / compensation path can reach it; it only
/// leaves through the two doors in contract-ledger.service (the contract's own verified PT-fault compensation, and the release to AVAILABLE).
/// Per contract the held amount is Σ HOLDBACK rows of that contract's payment transaction id.
enum LedgerBucket {
  PENDING
  AVAILABLE
  LOCKED
  HOLDBACK
}

enum RelatedEntityType {
  GYM_MEMBERSHIP
  PT_CONTRACT
  WALLET_TOPUP
  TRAINING_PACKAGE_PURCHASE
  PERSONALIZED_SERVICE_PURCHASE
}

enum ActivationStatus {
  NOT_APPLICABLE
  PENDING
  ACTIVATED
  ACTIVATION_FAILED
}

/// Two-bucket wallet.
///
/// `pendingBalance` is money already attributed to the owner but not yet earned — it backs
/// the sessions of a contract that have not happened yet, and is exactly the pot a refund
/// draws from. `availableBalance` is money the owner may withdraw.
///
/// Two PLATFORM wallets exist, distinguished by ownerId (see PLATFORM_ESCROW_ID /
/// PLATFORM_REVENUE_ID): ESCROW holds every đồng the platform is custodian of, REVENUE
/// holds commission the platform has actually earned. Keeping them apart is what makes the
/// reconciliation invariant checkable — a single mixed wallet has no interpretable balance
/// once several contracts run at once.
model Wallet {
  id               String          @id @default(uuid())
  ownerType        WalletOwnerType @map("owner_type")
  ownerId          String          @map("owner_id")
  availableBalance Decimal         @db.Decimal(14, 2) @default(0) @map("available_balance")
  pendingBalance   Decimal         @db.Decimal(14, 2) @default(0) @map("pending_balance")
  lockedBalance    Decimal         @db.Decimal(14, 2) @default(0) @map("locked_balance")
  /// FH-9: earned PT money held back per contract (see LedgerBucket.HOLDBACK). Not withdrawable.
  holdbackBalance  Decimal         @db.Decimal(14, 2) @default(0) @map("holdback_balance")
  status           WalletStatus    @default(ACTIVE)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  ledgerEntries WalletLedgerEntry[]
  withdrawalRequests WithdrawalRequest[]

  @@unique([ownerType, ownerId])
  @@map("wallets")
}

model WalletLedgerEntry {
  id            String          @id @default(uuid())
  walletId      String          @map("wallet_id")
  transactionId String          @map("transaction_id")
  entryType     LedgerEntryType @map("entry_type")
  /// Which balance moved. balanceBefore/balanceAfter are that bucket's running total, so a
  /// wallet's two buckets each form their own unbroken chain.
  bucket        LedgerBucket    @default(AVAILABLE)
  amount        Decimal         @db.Decimal(14, 2)
  balanceBefore Decimal         @db.Decimal(14, 2) @map("balance_before")
  balanceAfter  Decimal         @db.Decimal(14, 2) @map("balance_after")
  description   String?
  createdAt     DateTime        @default(now()) @map("created_at")

  wallet      Wallet             @relation(fields: [walletId], references: [id])
  transaction PaymentTransaction @relation(fields: [transactionId], references: [id])

  @@index([walletId, createdAt])
  @@index([walletId, bucket, createdAt])
  @@index([transactionId])
  @@map("wallet_ledger_entries")
}

enum WithdrawalRequestStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

/// Money-flow redesign plan 5.3 — "luồng rút tiền bán thủ công". Deliberately minimal: no
/// payout-API integration (chi ra ngoài vẫn thủ công, §5.3's explicit constraint). The ledger
/// debit only happens at `markPaid`, when an admin confirms a real bank/e-wallet transfer
/// already happened outside this system — this row exists to track that transfer, not to
/// trigger it.
model WithdrawalRequest {
  id              String                  @id @default(uuid())
  walletId        String                  @map("wallet_id")
  ownerType       WalletOwnerType         @map("owner_type")
  ownerId         String                  @map("owner_id")
  amount          Decimal                 @db.Decimal(14, 2)
  status          WithdrawalRequestStatus @default(PENDING)
  /// Bank account / e-wallet details the requester provided — free text, no payout API to
  /// validate a schema against.
  payoutInfo      String                  @map("payout_info")
  /// Filled in by the admin at markPaid — the paper trail for the transfer that happened
  /// manually, outside this system.
  bankReference   String?                 @map("bank_reference")
  rejectionReason String?                 @map("rejection_reason")
  reviewedBy      String?                 @map("reviewed_by")
  reviewedAt      DateTime?               @map("reviewed_at")
  paidAt          DateTime?               @map("paid_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  wallet Wallet @relation(fields: [walletId], references: [id])

  // The withdrawable-balance query (walletId, status) and the admin queue (status alone).
  @@index([walletId, status])
  @@index([status])
  @@map("withdrawal_requests")
}

model PaymentTransaction {
  id                    String              @id @default(uuid())
  payerId               String              @map("payer_id")
  purpose               PurposeType
  gymId                 String?             @map("gym_id")
  ptId                  String?             @map("pt_id")
  membershipId          String?             @map("membership_id")
  ptContractId          String?             @map("pt_contract_id")
  amount                Decimal             @db.Decimal(12, 2)
  currency              String              @default("VND")
  status                PaymentStatus       @default(PENDING)
  provider              PaymentProviderType @default(MOCK)
  providerTransactionId String?             @map("provider_transaction_id")
  paymentMethod         String?             @map("payment_method")
  idempotencyKey        String              @unique @map("idempotency_key")
  requestFingerprint    String?             @map("request_fingerprint")
  extraData             String?             @map("extra_data")
  paidAt                DateTime?           @map("paid_at")
  failedAt              DateTime?           @map("failed_at")
  refundedAt            DateTime?           @map("refunded_at")
  metadata              Json?

  payerWalletId       String?            @map("payer_wallet_id")
  receiverWalletId    String?            @map("receiver_wallet_id")
  relatedEntityType   RelatedEntityType? @map("related_entity_type")
  relatedEntityId     String?            @map("related_entity_id")
  activationStatus    ActivationStatus   @default(NOT_APPLICABLE) @map("activation_status")
  // On REFUND-purpose rows, "activation" means "the downstream cancel-after-refund succeeded" —
  // reusing this one status/retry pair for both flows avoids a near-duplicate set of columns.
  activationRetryCount  Int              @default(0) @map("activation_retry_count")
  lastActivationRetryAt DateTime?        @map("last_activation_retry_at")
  initiatedBy           String?          @default("SYSTEM") @map("initiated_by")
  sourceService         String?          @default("payment-service") @map("source_service")
  refundOfTransactionId String?          @map("refund_of_transaction_id")

  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  commissions   PlatformCommission[]
  ledgerEntries WalletLedgerEntry[]
  unpaidObligations ContractUnpaidObligation[]

  @@index([payerId, status])
  @@index([status])
  @@index([providerTransactionId])
  @@index([purpose, status, activationStatus])
  @@index([refundOfTransactionId])
  @@map("payment_transactions")
}

model PlatformCommission {
  id                   String           @id @default(uuid())
  paymentTransactionId String           @map("payment_transaction_id")
  partnerType          PartnerType      @map("partner_type")
  partnerId            String           @map("partner_id")
  grossAmount          Decimal          @db.Decimal(12, 2) @map("gross_amount")
  platformFeeAmount    Decimal          @db.Decimal(12, 2) @map("platform_fee_amount")
  partnerPayoutAmount  Decimal          @db.Decimal(12, 2) @map("partner_payout_amount")
  commissionRate       Decimal          @db.Decimal(5, 4) @map("commission_rate")
  status               CommissionStatus @default(PENDING)
  settledAt            DateTime?        @map("settled_at")
  createdAt            DateTime         @default(now()) @map("created_at")

  transaction PaymentTransaction @relation(fields: [paymentTransactionId], references: [id])

  @@index([partnerType, partnerId, status])
  @@index([paymentTransactionId])
  @@map("platform_commissions")
}

/// Money a partner owes back to the platform.
///
/// Raised when a client had to be made whole but the partner's buckets could not cover their
/// share — a PT who missed enough sessions to exhaust their pending balance, typically. The
/// platform fronts the cash so the client is never short-changed, and books the difference
/// here. Without this row the shortfall would either push a wallet negative or silently break
/// the reconciliation invariant; instead it stays visible and recoverable.
model PartnerReceivable {
  id            String      @id @default(uuid())
  partnerType   PartnerType @map("partner_type")
  partnerId     String      @map("partner_id")
  amount        Decimal     @db.Decimal(14, 2)
  /// Recovered so far, by withholding from the partner's later credits.
  recovered     Decimal     @default(0) @db.Decimal(14, 2)
  reason        String
  contractId    String?     @map("contract_id")
  transactionId String?     @map("transaction_id")
  settledAt     DateTime?   @map("settled_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  /// FH-8 (D62 C.4). Collection of THIS row is paused while suspendedAt is set. History is kept; nothing is
  /// marked paid and `recovered` is never touched. Set/cleared only by the audited adjustment operation.
  suspendedAt      DateTime? @map("suspended_at")
  suspendedBy      String?   @map("suspended_by")
  suspensionReason String?   @map("suspension_reason")
  /// Approval / minute number the owner gave for the suspension.
  suspensionRef    String?   @map("suspension_ref")
  /// FH-8. Part of `amount` the platform has agreed to bear (forgiven). Outstanding = amount - recovered - waived.
  waived           Decimal   @default(0) @db.Decimal(14, 2)
  waivedAt         DateTime? @map("waived_at")
  waivedBy         String?   @map("waived_by")
  waiveReason      String?   @map("waive_reason")
  waiveRef         String?   @map("waive_ref")

  events PartnerReceivableEvent[]

  @@index([partnerType, partnerId, settledAt])
  @@map("partner_receivables")
}

/// Business-key idempotency for financial ledger operations that are NOT a
/// PaymentTransaction (money-flow redesign plan item 1.1) — release-session,
/// no-show compensation, contract termination, membership referral settle/
/// clawback, membership pending-release. Each is written inside the SAME DB
/// transaction as the wallet movements it guards (see contract-ledger.service.ts's
/// / membership-ledger.service.ts's `withIdempotentLedgerOp`), so a crash between
/// "money moved" and "this row committed" is impossible: either both land or
/// neither does. A retry with the same `key` finds this row and replays `result`
/// instead of moving money again — the "gọi lại cùng khoá phải là thao tác vô hại"
/// requirement.
///
/// `key` follows a fixed per-operation-type format so it is self-describing in an
/// audit query, e.g. `SESSION_RELEASE:<sessionId>`, `CONTRACT_TERMINATE:<contractId>`,
/// `MEMBERSHIP_RELEASE:<membershipId>` — see docs/money-flow.md for the full list.
model LedgerOperation {
  id        String   @id @default(uuid())
  key       String   @unique
  result    Json
  createdAt DateTime @default(now()) @map("created_at")
  /// FH-2b. Hash of the IMMUTABLE fields of the request that claimed this key (kind, transaction,
  /// price, session count, rates, parties, reason/outcome). NULL on rows written before the column
  /// existed and on callers that do not fingerprint: those replay exactly as they always did.
  requestFingerprint String? @map("request_fingerprint")
  /// FH-2b. The payment transaction the operation moved money for; lets a later operation (and
  /// the read-only lookup) find "has this transaction been terminated" without parsing keys.
  transactionId      String? @map("transaction_id")
  /// FH-2b. RELEASE_SESSION | NO_SHOW | LATE_ARRIVAL | TERMINATE | RESOLVE_UNRESOLVED | ...
  kind               String?

  @@index([transactionId])
  @@map("ledger_operations")
}

enum ContractUnpaidObligationKind {
  NO_SHOW
  LATE_ARRIVAL
  REFUND_SHORT
  OVER_RELEASED
}

/// OPEN = recorded; UNDER_REVIEW = an owner/operator is looking at it.
/// Payment lifecycle (FH-8, owner decision: nothing is "paid" without VERIFIED evidence, by a second person):
///   APPROVED_FOR_PAYMENT = an authorised approver approved paying an exact amount from a manual (outside-the-ledger) source;
///   AWAITING_EVIDENCE    = the payment was made outside and evidence was recorded; waiting for a DIFFERENT person to verify it;
///   PAID_VERIFIED        = the evidence was verified against the approval and the whole obligation is covered (terminal);
///                          a PARTIAL verified payment returns the row to OPEN with a smaller `unpaid` and `verifiedPaid` > 0.
/// WAIVED = the owner decided not to pursue (the client is NOT paid); RESOLVED_OTHER = settled by another method, reason mandatory.
/// LEGACY: PAID_EXTERNALLY = "evidence recorded, NOT verified" (written by the FH-8 first cut before verification existed; never
/// auto-upgraded, no new row can enter it); RESOLVED = legacy "handled elsewhere".
enum ContractUnpaidObligationStatus {
  OPEN
  RESOLVED
  WAIVED
  UNDER_REVIEW
  PAID_EXTERNALLY
  APPROVED_FOR_PAYMENT
  AWAITING_EVIDENCE
  PAID_VERIFIED
  RESOLVED_OTHER
}

/// FH-1 (D48 / N7). What a PT-fault step on ONE contract could not pay out of that contract's own
/// pending money. It is an unpaid obligation TO THE CLIENT (or, for OVER_RELEASED, an incident for
/// the admin) — never a PT debt: no PartnerReceivable is created, the platform does not front it and
/// the PT's pooled balance is not touched. Written in the same DB transaction as the ledger rows,
/// keyed by the idempotency key of the operation, so a retry can never create a second one.
model ContractUnpaidObligation {
  id            String                         @id @default(uuid())
  /// Idempotency key of the operation (OVER_RELEASED rows add `#OVER_RELEASED:<party>`).
  key           String                         @unique
  transactionId String                         @map("transaction_id")
  /// Contract reference the caller labelled the operation with (the ledger label).
  contractRef   String?                        @map("contract_ref")
  kind          ContractUnpaidObligationKind
  /// Who the obligation is owed to: CLIENT, or the over-released party (PT | GYM | PLATFORM).
  party         String
  owed          Decimal                        @db.Decimal(14, 2)
  paid          Decimal                        @db.Decimal(14, 2)
  unpaid        Decimal                        @db.Decimal(14, 2)
  /// FH-8: total paid to the client OUTSIDE this ledger (evidence in the events). Never a wallet credit.
  externallyPaid Decimal                       @default(0) @db.Decimal(14, 2) @map("externally_paid")
  /// FH-8: total paid outside the ledger AND VERIFIED by a second person (sum of VERIFIED payments). Only this reduces `unpaid`
  /// in the current lifecycle; `externallyPaid` is the legacy, unverified figure and is never written any more.
  verifiedPaid  Decimal                        @default(0) @db.Decimal(14, 2) @map("verified_paid")
  status        ContractUnpaidObligationStatus @default(OPEN)
  createdAt     DateTime                       @default(now()) @map("created_at")
  resolvedAt    DateTime?                      @map("resolved_at")
  resolvedBy    String?                        @map("resolved_by")
  resolvedNote  String?                        @map("resolved_note")
  /// Why the obligation exists, in words (D77: set by the record-only late-arrival operation; null on the rows FH-1 wrote).
  reason        String?

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id])
  events      ContractUnpaidObligationEvent[]
  payments    ContractUnpaidObligationPayment[]

  @@index([status])
  @@index([transactionId])
  @@map("contract_unpaid_obligations")
}

enum PartnerReceivableEventAction {
  SUSPEND
  RESUME
  WAIVE
}

/// FH-8. Append-only audit trail of every adjustment made to a PartnerReceivable. Rows are only ever inserted:
/// the operation code never updates or deletes them. `idempotencyKey` makes a replayed operation a no-op.
model PartnerReceivableEvent {
  id             String                         @id @default(uuid())
  receivableId   String                         @map("receivable_id")
  action         PartnerReceivableEventAction
  /// Amount the action concerned (the waived amount for WAIVE; the row's amount for SUSPEND/RESUME).
  amount         Decimal                        @db.Decimal(14, 2)
  reason         String
  approvedBy     String                         @map("approved_by")
  approvalRef    String                         @map("approval_ref")
  idempotencyKey String                         @unique @map("idempotency_key")
  beforeJson     Json                           @map("before_json")
  afterJson      Json                           @map("after_json")
  createdAt      DateTime                       @default(now()) @map("created_at")

  receivable PartnerReceivable @relation(fields: [receivableId], references: [id], onDelete: Restrict)

  @@index([receivableId])
  @@map("partner_receivable_events")
}

enum ContractUnpaidObligationEventAction {
  RESOLVE
  WAIVE
  REVIEW
  RELEASE_REVIEW
  PAY_EXTERNALLY
  APPROVE_PAYMENT
  SUBMIT_EVIDENCE
  VERIFY_PAYMENT
  CANCEL_APPROVAL
  RESOLVE_OTHER
}

/// FH-8. Append-only audit trail of status changes on ContractUnpaidObligation. A status change records who and why;
/// it moves no money.
model ContractUnpaidObligationEvent {
  id             String                              @id @default(uuid())
  obligationId   String                              @map("obligation_id")
  action         ContractUnpaidObligationEventAction
  note           String
  actor          String
  approvalRef    String                              @map("approval_ref")
  idempotencyKey String                              @unique @map("idempotency_key")
  fromStatus     ContractUnpaidObligationStatus      @map("from_status")
  toStatus       ContractUnpaidObligationStatus      @map("to_status")
  /// Unpaid amount at the time of the change (the CAS value the owner approved).
  unpaid         Decimal                             @db.Decimal(14, 2)
  /// PAY_EXTERNALLY evidence (null for the other actions): what was paid, the bank/transfer reference, the date it was paid,
  /// who approved it, and what stays unpaid afterwards.
  paidAmount        Decimal?                         @map("paid_amount") @db.Decimal(14, 2)
  transferReference String?                          @map("transfer_reference")
  paidOn            DateTime?                        @map("paid_on")
  approvedBy        String?                          @map("approved_by")
  unpaidAfter       Decimal?                         @map("unpaid_after") @db.Decimal(14, 2)
  /// Payment lifecycle events (APPROVE_PAYMENT .. CANCEL_APPROVAL): the payment record, its manual source, the recipient
  /// (taken from the ledger), the evidence pointers and who verified it.
  paymentId         String?                          @map("payment_id")
  paymentSource     String?                          @map("payment_source")
  recipient         String?
  evidenceRef       String?                          @map("evidence_ref")
  evidenceHash      String?                          @map("evidence_hash")
  bankStatementId   String?                          @map("bank_statement_id")
  verifiedBy        String?                          @map("verified_by")
  createdAt      DateTime                            @default(now()) @map("created_at")

  obligation ContractUnpaidObligation @relation(fields: [obligationId], references: [id], onDelete: Restrict)

  @@index([obligationId])
  @@map("contract_unpaid_obligation_events")
}

enum ContractUnpaidObligationPaymentStatus {
  APPROVED
  EVIDENCE_SUBMITTED
  VERIFIED
  CANCELLED
}

/// FH-8. ONE manual (outside-the-ledger) payment of an unpaid obligation: approved -> evidence submitted -> verified (or cancelled).
/// At most ONE open (APPROVED / EVIDENCE_SUBMITTED) row per obligation (partial unique index in the migration), so the sum of
/// VERIFIED payments can never exceed what was owed. Recipient comes from the ledger (the obligation's party; for a CLIENT
/// obligation the payer of the payment transaction), never from input. Moves no money: no wallet / ledger / receivable row.
/// DELETE is rejected and the identity columns are immutable (trigger in the migration); the event table keeps the full history.
model ContractUnpaidObligationPayment {
  id               String                                 @id @default(uuid())
  obligationId     String                                 @map("obligation_id")
  approvalRef      String                                 @map("approval_ref")
  status           ContractUnpaidObligationPaymentStatus  @default(APPROVED)
  amount           Decimal                                @db.Decimal(14, 2)
  paymentSource    String                                 @map("payment_source")
  recipientParty   String                                 @map("recipient_party")
  recipientId      String?                                @map("recipient_id")
  approvedBy       String                                 @map("approved_by")
  approvedAt       DateTime                               @default(now()) @map("approved_at")
  /// Evidence (recorded by `recordedBy` AFTER the payment was made outside): what was paid, the transfer reference, the day,
  /// and a pointer to the proof (file reference / sha256 / bank statement id). NOT proof by itself - `verifiedBy` must confirm it.
  paidAmount       Decimal?                               @map("paid_amount") @db.Decimal(14, 2)
  transferReference String?                               @map("transfer_reference")
  paidOn           DateTime?                              @map("paid_on")
  evidenceRef      String?                                @map("evidence_ref")
  evidenceHash     String?                                @map("evidence_hash")
  bankStatementId  String?                                @map("bank_statement_id")
  recordedBy       String?                                @map("recorded_by")
  recordedAt       DateTime?                              @map("recorded_at")
  verifiedBy       String?                                @map("verified_by")
  verifiedAt       DateTime?                              @map("verified_at")
  cancelledBy      String?                                @map("cancelled_by")
  cancelledAt      DateTime?                              @map("cancelled_at")
  cancelReason     String?                                @map("cancel_reason")

  obligation ContractUnpaidObligation @relation(fields: [obligationId], references: [id], onDelete: Restrict)

  @@unique([obligationId, approvalRef])
  @@index([obligationId])
  @@map("contract_unpaid_obligation_payments")
}

model PaymentWebhookEvent {
  id                    String              @id @default(uuid())
  provider              PaymentProviderType
  providerEventId       String              @map("provider_event_id")
  providerTransactionId String?             @map("provider_transaction_id")
  payload               Json
  processedAt           DateTime?           @map("processed_at")
  retryCount            Int                 @default(0) @map("retry_count")
  lastRetryAt           DateTime?           @map("last_retry_at")
  createdAt             DateTime            @default(now()) @map("created_at")

  @@unique([provider, providerEventId])
  @@index([processedAt, retryCount])
  @@map("payment_webhook_events")
}

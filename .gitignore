# ------------------------------
# Dependencies / Package managers
# ------------------------------
node_modules/
**/node_modules/
.pnpm-store/

# ------------------------------
# Build outputs / caches
# ------------------------------
dist/
build/
**/.build/
coverage/
.turbo/
.cache/
*.tsbuildinfo
*.tmp
*.tmp*
*.temp

# Prisma's own generate step leaves libquery_engine-*.so.node.tmp<pid> behind whenever the
# target file is locked mid-write (e.g. generate running while the container that loaded the
# old engine is still up) — these are junk, never a real build artifact, and *.tmp above
# doesn't match them (the name ends in .tmp<pid>, not literal ".tmp").
**/generated/prisma/*.tmp*

# ------------------------------
# Terraform local state/plugins — provider binaries alone can exceed 1GB
# and must never be committed (blocked a real push to master on
# 2026-08-20: two .exe provider plugins over GitHub's 100MB limit).
# ------------------------------
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
**/tfplan*
crash.log
crash.*.log

# ------------------------------
# Logs
# ------------------------------
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------
# Environment / secrets
# ------------------------------
.env
.env.*
*.env
!.env.example
!.env.*.example

# Private keys / certificates
*.pem
*.key
*.p12
*.pfx
*.crt

# ------------------------------
# OS / editor / AI tools
# ------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/
.playwright-cli/

# ------------------------------
# Runtime / local data artifacts
# ------------------------------
*.db
*.sqlite
*.sqlite3
*.pids

# Docker / compose local overrides
docker-compose.override.yml

# Python
__pycache__/
**/__pycache__/
*.pyc
.venv/
**/.venv/

# InBody OCR debug output
output_debug/
**/output_debug/

# Temp files
tmp/

# Misc backups
*.bak
*.old
*.orig

# Temporary / local-only files
skills-main.zip
tmp-ai-request.json

# USDA FoodData Central raw downloads (large, not committed)
# Generate foods_seed.csv locally with: pnpm --filter @gym-coach/fitness-service db:process-usda
data/nutrition/
data/nutrition.zip

# Local test/scratch files
FitnessAssistant_TestPrompt_v2.md
data/nutrition/*.csv
data/nutrition/*.zip
data/nutrition/*.xlsx
data/nutrition/FoodData_Central_csv_2026-04-30

# Optional coach fine-tuning artifacts
training/outputs/
training/checkpoints/
training/adapters/
training/merged_models/
training/reports/
training/unsloth_compiled_cache/
# Anonymized production exports feeding the optional fine-tuning dataset —
# never committed, even scrubbed (see ai-service ai:export:finetune script).
training/data/raw/
# Vendored upstream clone used only for GGUF conversion tooling (own .git,
# ~200MB) — see training/scripts/merge_lora_unsloth.py's deployment flow.
training/llama.cpp/
backend/services/ai-service/src/scripts/.output/
*.safetensors
*.gguf

# ── Capacitor Android wrapper (frontend/web) ────────────────────────────────
# Build outputs + machine-specific SDK path + signing keys are never committed.
# The generated `android/` project itself IS committed (it carries the manifest
# permissions and gradle config the APK build depends on).
frontend/web/android/app/build/
frontend/web/android/local.properties
*.keystore
*.jks
# LAN-specific API endpoints for the APK build — differs per machine/network.
frontend/web/.env.capacitor

# Standalone browser QA project may contain authentication state.
fitnessassistant-playwright-e2e/

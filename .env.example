# Environment Variables Template
# Copy this to .env and fill in your values
# DO NOT commit real secrets to this file

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres is exposed on host port 5433 by docker-compose (internal port 5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=gymcoach
POSTGRES_PASSWORD=gymcoach_password
POSTGRES_DB=gymcoach
DATABASE_URL=postgresql://gymcoach:gymcoach_password@localhost:5433/gymcoach

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Bull Queue (uses same Redis instance)
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379

# ── Qdrant Vector DB ──────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# IMPORTANT: Change these to strong random strings before deploying to production
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Internal service-to-service auth secret (used by services when calling each other)
INTERNAL_SERVICE_SECRET=dev_internal_service_secret_change_in_production

# ── Service URLs ──────────────────────────────────────────────────────────────
# These are used by the gateway and inter-service calls (local dev: localhost, Docker: service names)
AUTH_SERVICE_URL=http://localhost:3001
FITNESS_SERVICE_URL=http://localhost:3002
AI_SERVICE_URL=http://localhost:3003
USER_SERVICE_URL=http://localhost:3004
CHAT_SERVICE_URL=http://localhost:3005

# Translation API (server-side only; frontend calls POST /api/translate)
# Supported providers: libretranslate | google | deepl
TRANSLATE_PROVIDER=libretranslate
TRANSLATE_API_KEY=
# Optional override for self-hosted LibreTranslate or custom provider endpoint.
TRANSLATE_API_URL=

# ── Chat Service ──────────────────────────────────────────────────────────────
CHAT_SERVICE_PORT=3005
CHAT_DATABASE_URL=postgresql://gymcoach:gymcoach_password@localhost:5433/gymcoach_chat

# ── WebRTC calls (PT<->client video/voice) — TURN server ───────────────────────
# call.handler.ts's getIceServers() always includes Google's public STUN servers, which is
# only enough when both peers are on simple/compatible NATs (e.g. the same LAN). Confirmed
# failing with "ice_failed" for any real cross-network pair — a phone on mobile data calling
# a laptop on a different connection — because most mobile carriers use symmetric NAT, which
# STUN cannot traverse; only a TURN relay both sides CAN reach fixes it.
#
# Defaults (see docker-compose.dev.yml) point at the Open Relay Project's free, publicly-
# published test credentials (metered.ca/tools/openrelay, no signup) — fine for dev/test
# traffic only. Before a real launch, replace with either a self-hosted coturn (needs a real
# public IP — a home dev machine behind a router/tunnel does not have one) or a paid hosted
# TURN provider (Twilio, Xirsys, Cloudflare Calls, metered.ca's paid tier).
# TURN_URL takes a comma-separated list — a real TURN deployment publishes several
# transports (UDP/TCP/TLS on different ports) for reliability across network restrictions.
# TURN_URL=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443,turn:openrelay.metered.ca:443?transport=tcp
# TURN_USERNAME=openrelayproject
# TURN_CREDENTIAL=openrelayproject

# ── Frontend dev-server proxying (Vite) ─────────────────────────────────────
# Leave VITE_API_URL / VITE_SOCKET_URL / VITE_CHAT_WS_URL unset (the default):
# the frontend then makes same-origin requests that vite.config.ts proxies to
# the targets below. This is what makes login work identically whether the
# app is opened at http://localhost:5173 or through a Dev Tunnel/port-
# forwarded HTTPS URL — the browser only ever talks to one origin, so there's
# no CORS preflight and no https-page-calling-http mixed-content block. Only
# set the VITE_* vars to an absolute URL if the frontend must bypass the
# proxy and reach a backend that isn't same-origin.
# VITE_API_URL=
# VITE_SOCKET_URL=
# VITE_CHAT_WS_URL=
# Read by vite.config.ts itself (Node process, not the browser bundle) — safe
# to point at Docker-internal hostnames. docker-compose.dev.yml already sets
# these for you; only needed if running `pnpm dev` outside Docker.
# GATEWAY_PROXY_TARGET=http://localhost:3000
# CHAT_PROXY_TARGET=http://localhost:3005
# Comma-separated extra Host headers Vite's dev server should accept, beyond
# localhost and *.devtunnels.ms (both always allowed already). Only needed
# for tunnel providers other than VS Code Dev Tunnels (e.g. ngrok).
# VITE_EXTRA_ALLOWED_HOSTS=

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Supported: ollama | anthropic | openai (any OpenAI-compatible API)
# For AWS/production deploys without a GPU instance, use LLM_PROVIDER=anthropic
# — chat completions go to the Claude API (needs ANTHROPIC_API_KEY below).
# Embeddings ALWAYS go through LLM_BASE_URL/Ollama regardless of this value
# (Claude has no embeddings endpoint) — keep the `ollama` container running
# CPU-only for EMBEDDING_MODEL even when LLM_PROVIDER=anthropic; the
# embedding model is small and does not need a GPU.
LLM_PROVIDER=ollama
LLM_API_KEY=
# ollama: e.g. fitness-coach-qwen2.5-1.5b:q4_K_M
# anthropic: e.g. claude-sonnet-5 (quality) or claude-haiku-4-5 (cheaper/faster)
LLM_MODEL=fitness-coach-qwen2.5-1.5b:q4_K_M
# Ollama runs directly on the dev laptop (not RunPod/tunnel, not the
# Docker-local `ollama` service under --profile local-ollama). Start it
# with `OLLAMA_HOST=0.0.0.0:11434 ollama serve` — 0.0.0.0, not 127.0.0.1,
# so Docker Desktop's host.docker.internal can actually reach it from
# inside containers.
# Windows host itself: http://127.0.0.1:11434
# Docker containers: http://host.docker.internal:11434
LLM_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_TIMEOUT_MS=300000
LLM_NUM_CTX=8192
LLM_JSON_NUM_CTX=8192

# ── Embedding Model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_MS=120000

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Use a Gmail App Password (not your regular Gmail password)
# See: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="AI Gym Coach <your_gmail_address@gmail.com>"
SMTP_SECURE=true

# ── OTP Settings ─────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ── n8n Workflow Orchestration ────────────────────────────────────────────────
# n8n runs at port 5678, managed via admin UI at /admin/workflows
N8N_HOST=localhost
N8N_PATH=/
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh

# Basic auth protects the n8n Studio UI (change before production)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_this_n8n_password
N8N_LICENSE_ACTIVATION_KEY=

# Public API key — generated inside n8n Studio → Settings → API
# Required for gateway to list workflows via /admin/workflows endpoint
# Leave empty if you don't need workflow listing in admin dashboard
N8N_PUBLIC_API_KEY=
N8N_PUBLIC_API_DISABLED=false

# Gateway env vars for n8n proxy (used in docker-compose, not needed for local-only dev)
N8N_BASE_URL=http://localhost:5678
N8N_EDITOR_BASE_PATH=/admin/workflows/studio

# Smoke test webhook URL — used by POST /admin/workflows/smoke-test
# Import infra/n8n/workflows/smoke-test-ping.json into n8n and activate it first.
# Docker Compose (gateway inside Docker): http://n8n:5678/webhook/gym-smoke-test
# Local dev (gateway outside Docker):     http://localhost:5678/webhook/gym-smoke-test
N8N_SMOKE_TEST_WEBHOOK_URL=

# E2E test webhook URL — used by POST /admin/workflows/full-system-test
# Import and activate 01-05 sub-workflows, then 06-gym-e2e-orchestrator.json.
# Docker Compose (gateway inside Docker): http://n8n:5678/webhook/gym-e2e-run
# Local dev (gateway outside Docker):     http://localhost:5678/webhook/gym-e2e-run
N8N_E2E_WEBHOOK_URL=

# ── Test Data Seeder ─────────────────────────────────────────────────────────
# db-seeder service runs automatically after docker compose up.
# Set to true to skip seeding (e.g., in staging or when you don't want test data).
SKIP_SEED=false

# ── Dropbox Sign (E-Signature — MVP test mode only) ──────────────────────────
# Get your API key from: https://app.hellosign.com/api/reference/operation/accountGet
DROPBOX_SIGN_API_KEY=your_dropbox_sign_api_key_here
# Always true in MVP — prevents production-mode signing
DROPBOX_SIGN_TEST_MODE=true
# Set to MOCK to skip Dropbox Sign (no API key needed); DROPBOX_SIGN to use real API
ESIGN_PROVIDER=DROPBOX_SIGN
# Path to a Unicode-capable font for PDF generation (DejaVu supports Vietnamese)
# Alpine/Debian Docker default: /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# Windows local dev override: C:/Windows/Fonts/arial.ttf
PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# ── InBody scan extraction (user-service) ────────────────────────────────────
# Supported: ollama (default, local/offline) | anthropic (Claude vision API)
# Local is the default as of 2026-09-01 — no InBody photo or extracted body
# metric leaves the machine unless this is explicitly set to `anthropic`.
# Reuses the SAME Ollama instance as ai-service's LLM_PROVIDER (LLM_BASE_URL/
# OLLAMA_BASE_URL above) — no second Ollama deployment needed, just pull a
# vision-capable model into it:
#   docker exec gymcoach-ollama ollama pull qwen2.5vl:3b
INBODY_VISION_PROVIDER=ollama
# qwen2.5vl:3b chosen for CPU-only dev machines (no GPU passthrough into the
# ollama container by default) — noticeably better at reading the InBody
# report's mixed number-table + segmental-silhouette-chart layout than
# llava/moondream at a similar size. If you have a GPU passed into Docker or
# don't mind slower CPU inference, qwen2.5vl:7b / llama3.2-vision:11b /
# minicpm-v are more accurate — pull whichever and point this at it.
INBODY_VISION_OLLAMA_MODEL=qwen2.5vl:3b
# Override only if InBody extraction should hit a different Ollama instance
# than ai-service's chat/embeddings — defaults to OLLAMA_BASE_URL/LLM_BASE_URL.
# INBODY_VISION_OLLAMA_BASE_URL=
# CPU-only vision inference on a small model can take 30-90s per image —
# well under the frontend's own 180s upload timeout (api.ts), but generous
# enough that a first cold-start pull/load doesn't spuriously fail.
INBODY_VISION_OLLAMA_TIMEOUT_MS=150000

# ── Anthropic Claude API ──────────────────────────────────────────────────────
# Used for AI chat/plan-generation completions (ai-service) when
# LLM_PROVIDER=anthropic, and for InBody scan extraction (user-service) only
# when INBODY_VISION_PROVIDER=anthropic above.
# Get your key from https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
INBODY_VISION_MODEL=claude-sonnet-4-6

# ── Payment gateways (wallet top-up) ─────────────────────────────────────────
# Sandbox gateways only — the MOCK provider that auto-credited wallets was removed,
# so topping up now REQUIRES at least one gateway's sandbox credentials below.
# Fallback gateway when a top-up request does not name one (the web UI always does).
PAYMENT_PROVIDER=VNPAY
# VNPay sandbox — register at https://sandbox.vnpayment.vn/devreg/
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_RETURN_URL=http://localhost:3007/payments/vnpay/return
# true → local stand-in checkout page at /payments/vnpay/sim (same signing/verify/credit
# code path) for when the VNPay sandbox itself is unreachable.
VNPAY_SIMULATE=false
# ZaloPay sandbox — app_id 2553 + its key1/key2 are ZaloPay's public test merchant
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
# PayOS is VietQR with REAL money and no play-money sandbox — leave empty unless you
# mean it (also hidden from the top-up dropdown).
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Node / Gateway ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# ── Production / AWS deployment only (docker-compose.prod.yml) ───────────────
# Not used by docker-compose.dev.yml — irrelevant for local dev.
# JWT_SECRET / INTERNAL_SERVICE_SECRET above and INTERNAL_API_SECRET below
# MUST be real random values in production (e.g. `openssl rand -hex 32`) —
# docker-compose.prod.yml has no dev-default fallback for these, unlike the
# dev compose file, so a missing value here is an empty/broken secret, not a
# safe default.
INTERNAL_API_SECRET=
# RDS PostgreSQL endpoint (no port, no db name — docker-compose.prod.yml
# appends :5432/<db-name>?sslmode=require per service)
RDS_ENDPOINT=your-db-instance.xxxxxxxxxx.us-east-1.rds.amazonaws.com
RDS_USER=gymcoach_admin
RDS_PASSWORD=
# Redis/Qdrant/Ollama stay as containers for the MVP (no ElastiCache) — see
# infra/compose/docker-compose.prod.yml, no extra env var needed for them.
# The EC2 instance's Elastic IP (or domain once you have one), e.g.
# http://203.0.113.10 — used for CORS_ORIGIN above and FRONTEND_URL below.
FRONTEND_URL=

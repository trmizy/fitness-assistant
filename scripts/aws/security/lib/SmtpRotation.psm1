<#
.SYNOPSIS
  Zero-exposure SMTP_PASS rotation — pure logic only (Phase 13D).

.DESCRIPTION
  Same pure-logic/AWS-I-O separation as JwtRotation.psm1 and
  InternalSecretRotation.psm1. Self-contained (no cross-module import) so
  it can be reviewed and tested independently. Single target
  (fitness-assistant-dev-auth is the SOLE SMTP consumer in this codebase -
  confirmed by reading email.service.ts: it is the only file anywhere that
  imports nodemailer or reads SMTP_PASS; every other service that needs to
  send an email calls INTO auth-service's own `/internal/send-email` route
  rather than holding its own SMTP credential).

  The new credential in this rotation is always HUMAN-PROVIDED (a Gmail App
  Password cannot and must not be generated programmatically - see the
  design report's "Verify Google/Gmail App Password Model" section), never
  generated by this module. There is deliberately no
  "New-SmtpPasswordValue"-style function here.
#>

Set-StrictMode -Version Latest

$Script:TargetFunction = "fitness-assistant-dev-auth"
$Script:SmtpKeyName = "SMTP_PASS"

function Get-SmtpTargetFunction { $Script:TargetFunction }
function Get-SmtpKeyName { $Script:SmtpKeyName }

<#
.SYNOPSIS
  PURE. Fail-closed account/region/target-function check (4, 5 - wrong
  account/region fail).
#>
function Test-SmtpRotationPreconditions {
    param(
        [Parameter(Mandatory)] [string]$ActualAccount,
        [Parameter(Mandatory)] [string]$ExpectedAccount,
        [Parameter(Mandatory)] [string]$ActualRegion,
        [Parameter(Mandatory)] [string]$ExpectedRegion,
        [Parameter(Mandatory)] [string]$ActualFunctionName,
        [Parameter(Mandatory)] [string]$ExpectedFunctionName
    )
    if ($ActualAccount -ne $ExpectedAccount) {
        return @{ Ok = $false; Reason = "Account '$ActualAccount' != expected '$ExpectedAccount'" }
    }
    if ($ActualRegion -ne $ExpectedRegion) {
        return @{ Ok = $false; Reason = "Region '$ActualRegion' != expected '$ExpectedRegion'" }
    }
    if ($ActualFunctionName -ne $ExpectedFunctionName) {
        return @{ Ok = $false; Reason = "Target function '$ActualFunctionName' != expected '$ExpectedFunctionName'" }
    }
    return @{ Ok = $true; Reason = $null }
}

<#
.SYNOPSIS
  PURE (1 - SMTP_PASS replaced, 2 - unrelated env vars preserved, 3 -
  missing SMTP_PASS -> fail, 12 - merge changes only SMTP_PASS). Returns a
  NEW hashtable equal to CurrentEnv except SMTP_PASS is replaced by
  NewValue - every other key byte-identical. Refuses to add SMTP_PASS as a
  brand-new key (it must already exist - this rotation replaces a known
  credential, it does not provision SMTP for the first time).
#>
function Merge-RotatedSmtpPassword {
    param(
        [Parameter(Mandatory)] [hashtable]$CurrentEnv,
        [Parameter(Mandatory)] [AllowEmptyString()] [string]$NewValue
    )
    if (-not $CurrentEnv.ContainsKey($Script:SmtpKeyName)) {
        return @{ Ok = $false; Reason = "SMTP_PASS not present in current environment - refusing to add a new key as part of a rotation."; MergedEnv = $null }
    }
    if ([string]::IsNullOrEmpty($NewValue)) {
        return @{ Ok = $false; Reason = "Refusing to rotate SMTP_PASS to an empty value."; MergedEnv = $null }
    }
    $merged = @{}
    foreach ($k in $CurrentEnv.Keys) { $merged[$k] = $CurrentEnv[$k] }
    $merged[$Script:SmtpKeyName] = $NewValue

    $beforeKeys = [System.Collections.Generic.HashSet[string]]::new([string[]]$CurrentEnv.Keys)
    $afterKeys = [System.Collections.Generic.HashSet[string]]::new([string[]]$merged.Keys)
    if (-not $beforeKeys.SetEquals($afterKeys)) {
        return @{ Ok = $false; Reason = "Internal error: merged key set does not match original key set - refusing to proceed."; MergedEnv = $null }
    }
    return @{ Ok = $true; Reason = $null; MergedEnv = $merged }
}

<#
.SYNOPSIS
  PURE (6 - RevisionId mismatch -> fail). Optimistic-concurrency check.
#>
function Test-SmtpConcurrencyToken {
    param(
        [Parameter(Mandatory)] [string]$ExpectedRevisionId,
        [Parameter(Mandatory)] [string]$ActualRevisionId
    )
    if ($ExpectedRevisionId -ne $ActualRevisionId) {
        return @{ Ok = $false; Reason = "RevisionId mismatch - something else changed this Lambda between read and write. Refusing to overwrite." }
    }
    return @{ Ok = $true; Reason = $null }
}

<#
.SYNOPSIS
  Builds the ONLY object the orchestrator is allowed to print (7 - no
  plaintext in stdout). Explicit field whitelist - structurally incapable
  of forwarding SMTP_PASS's value.
#>
function Get-SanitizedSmtpSummary {
    param(
        [Parameter(Mandatory)] [string]$TargetFunction,
        [Parameter(Mandatory)] [bool]$SmtpPassPresent,
        [Parameter(Mandatory)] [bool]$RotationReady,
        [string]$RevisionId = $null,
        [string]$UpdateStatus = $null,
        [string]$NewRevisionId = $null,
        [string]$LastModified = $null,
        [int]$EnvironmentKeysFound = 0
    )
    return [ordered]@{
        TargetFunction       = $TargetFunction
        SmtpPassPresent      = $SmtpPassPresent
        RotationReady        = $RotationReady
        RevisionId           = $RevisionId
        UpdateStatus         = $UpdateStatus
        NewRevisionId        = $NewRevisionId
        LastModified         = $LastModified
        EnvironmentKeysFound = $EnvironmentKeysFound
    }
}

Export-ModuleMember -Function @(
    'Get-SmtpTargetFunction',
    'Get-SmtpKeyName',
    'Test-SmtpRotationPreconditions',
    'Merge-RotatedSmtpPassword',
    'Test-SmtpConcurrencyToken',
    'Get-SanitizedSmtpSummary'
)
